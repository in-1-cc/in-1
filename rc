# shellcheck shell=bash
#
# in-1.cc - instant dev tools for your current shell
#
# Usage:
#   source <(curl -sL in-1.cc) TOOL... [VAR=VALUE]...   # bash / zsh
#   curl -sL in-1.cc | source - TOOL... [VAR=VALUE]...  # fish
#
# For example:
#   source <(curl -sL in-1.cc) rust node
#   source <(curl -sL in-1.cc) perl PERL-VERSION=5.42.0
#   source <(curl -sL in-1.cc) -U rust     # update in-1 first
#   source <(curl -sL in-1.cc) -R rust     # start clean first
#
# Docs:   https://in-1.cc/home/
# Source: https://github.com/in-1-cc/in-1
#
# This clones in-1 (default /tmp/in-1), installs the requested tools
# under that clone and sets up PATH, MANPATH, completions and tool env
# vars in your current shell for the duration of the shell session.

test -n "$BASH_VERSION$ZSH_VERSION" && eval '
_in1_boot() {
  local pin=${IN1_VERSION:-@IN1_VERSION@}
  local tmp=${TMPDIR:-/tmp}
  local root=${IN1_ROOT:-${tmp%/}/in-1}
  local repo=${IN1_REPO:-https://github.com/in-1-cc/in-1}
  local shell=bash fresh="" out

  [ -n "${ZSH_VERSION-}" ] && shell=zsh

  command -v git >/dev/null 2>&1 || {
    echo "in-1: git is required" >&2
    return 1
  }

  # The root is the in-1 clone itself
  if [ ! -x "$root/bin/in-1" ]; then
    if [ -d "$root" ] && [ -n "$(ls -A "$root" 2>/dev/null)" ]; then
      echo "in-1: $root is not an in-1 clone (old layout?);" \
        "remove it and retry" >&2
      return 1
    fi
    mkdir -p "$(dirname "$root")" || return 1
    git clone -q "$repo" "$root" || {
      echo "in-1: failed to clone $repo" >&2
      return 1
    }
    fresh=1
  fi

  # Use the in-1 version this script was published with, unless the
  # version token was never stamped (running from a working copy).
  # A clone already on a branch (after in-1 -U, say) is left there
  # unless IN1_VERSION asks for something else.
  if [ "$pin" != "@IN1_VERSION""@" ]; then
    if [ -n "$fresh" ] || [ -n "${IN1_VERSION-}" ] ||
       ! git -C "$root" symbolic-ref -q HEAD >/dev/null 2>&1; then
      git -C "$root" rev-parse -q --verify "$pin^{commit}" \
        >/dev/null 2>&1 ||
        git -C "$root" fetch -q --tags origin 2>/dev/null
      git -C "$root" checkout -q "$pin" || {
        echo "in-1: failed to checkout in-1 version $pin" >&2
        return 1
      }
    fi
  fi

  out=$(bash "$root/bin/in-1" --env "$shell" "$@") || return 1
  eval "$out"
}

_in1_boot "$@"
_in1_status=$?
unset -f _in1_boot
if [ "$_in1_status" -eq 0 ]; then
  unset _in1_status
  return 0
else
  unset _in1_status
  return 1
fi
'

test -n "$FISH_VERSION" && eval '
function _in1_boot
  set -l pin "$IN1_VERSION"
  test -n "$pin"; or set pin @IN1_VERSION@
  set -l tmp "$TMPDIR"
  test -n "$tmp"; or set tmp /tmp
  set -l root "$IN1_ROOT"
  test -n "$root"; or set root (string trim -r -c / -- $tmp)/in-1
  set -l repo "$IN1_REPO"
  test -n "$repo"; or set repo https://github.com/in-1-cc/in-1
  set -l fresh ""

  command -q git; or begin
    echo "in-1: git is required" >&2
    return 1
  end

  if not test -x $root/bin/in-1
    if test -d $root; and test (count (ls -A $root 2>/dev/null)) -gt 0
      echo "in-1: $root is not an in-1 clone (old layout?);" \
        "remove it and retry" >&2
      return 1
    end
    mkdir -p (dirname $root); or return 1
    git clone -q $repo $root; or begin
      echo "in-1: failed to clone $repo" >&2
      return 1
    end
    set fresh 1
  end

  if test "$pin" != "@IN1_VERSION""@"
    if test -n "$fresh"; or test -n "$IN1_VERSION"; \
       or not git -C $root symbolic-ref -q HEAD >/dev/null 2>&1
      git -C $root rev-parse -q --verify "$pin^{commit}" \
        >/dev/null 2>&1
      or git -C $root fetch -q --tags origin 2>/dev/null
      git -C $root checkout -q $pin; or begin
        echo "in-1: failed to checkout in-1 version $pin" >&2
        return 1
      end
    end
  end

  set -l envfile (mktemp)
  if bash $root/bin/in-1 --env fish $argv > $envfile
    source $envfile
    rm -f $envfile
  else
    rm -f $envfile
    return 1
  end
end

_in1_boot $argv
set -l _in1_status $status
functions -e _in1_boot
return $_in1_status
'

echo "ERROR: in-1.cc requires bash, zsh or fish" >&2
false

