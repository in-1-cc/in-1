# shellcheck shell=bash
# Common test bootstrap; sourced by every test/*.t file.
# shellcheck disable=SC1091,SC2034

set -euo pipefail

source "$BPAN_ROOT/lib/bpan.bash" --

bpan:source bashplus +cmd +sys
bpan:source test-tap --

export BPAN_TEST_RUNNING=1

FILE=$0
NAME=$(basename "$FILE")
NAME=${NAME%.t}
ROOT=$(cd "$(dirname "$FILE")"/.. && pwd -P)
[[ -f $ROOT/License ]] ||
  die "Can't find ROOT"
TEST=$ROOT/test

if [[ $* == *slow* ]]; then
  if [[ -z ${slow-} ]]; then
    pass "Use slow=1 to run slow tests"
    done-testing
    exit 0
  fi
fi

# in-1 test scaffolding:
#
# Each test gets its own scratch TMPDIR and IN1_ROOT, a stand-in for
# an in-1 clone that links back to this working copy, so the stub never
# needs to clone in-1.  makes is cloned from a local repo, so only tool
# downloads can hit the network; those are cached in a dir shared by
# all tests.

SCRATCH=$ROOT/.cache/test/$NAME
rm -rf "$SCRATCH"
mkdir -p "$SCRATCH"

export TMPDIR=$SCRATCH
export IN1_ROOT=$TMPDIR/in-1/share/in-1/local
export IN1_REPO=$ROOT
export IN1_CACHE=$ROOT/.cache/test/downloads
export IN1_MAKES_REPO=${IN1_MAKES_REPO:-$ROOT/.cache/makes}
unset IN1_VERSION IN1_UPDATE IN1_OFFLINE IN1_PREFIX IN1_TOOLS PREFIX
unset BASH_ENV ENV CDPATH MANPATH
unset -f in-1 2>/dev/null || true
export ZDOTDIR=$SCRATCH/zsh-config
mkdir -p "$ZDOTDIR"

# Build an in-1 clone stand-in at $1: a real bin/ whose in-1 links to
# this working copy's command (so it resolves its own root to $1, as
# a real clone would), plus links to everything else it and the
# sourceable files need.
make-in1-root() (
  f=''
  mkdir -p "$1/bin"
  ln -s "$ROOT/bin/in-1" "$1/bin/in-1"
  for f in share man rc .rc; do
    ln -s "$ROOT/$f" "$1/$f"
  done
)

make-in1-root "$IN1_ROOT"
make-in1-root "$TMPDIR/in-1/bootstrap"

# Always shadow any real installation, including /usr/local/bin/in-1.
# This is an uninstalled checkout, so default-prefix discovery still works
# normally and tests can explicitly prepend their own installed fixtures.
# Keep it outside the directories exercised by reset and bootstrap tests.
make-in1-root "$SCRATCH/launcher"
export PATH=$SCRATCH/launcher/bin:$PATH
hash -r

# Noninteractive fish still reads user configuration unless told otherwise.
# Keep its real executable available, but never load personal shell setup.
if fish_exe=$(type -P fish); then
  printf '#!/usr/bin/env bash\nexec %q --no-config "$@"\n' "$fish_exe" \
    > "$SCRATCH/launcher/bin/fish"
  chmod +x "$SCRATCH/launcher/bin/fish"
fi

# Build a throwaway in-1 repo at $1 with this working copy's files
# (tracked and untracked) committed on the current branch, so that an
# in-1.mk install cloning it tests the code here, not the last commit.
# Sets make args for its current branch and for its main branch.
make-in1-repo() {
  local f
  git clone -q "$ROOT" "$1"
  git -C "$ROOT" ls-files -z -co --exclude-standard |
    while IFS= read -rd '' f; do
      [[ -f $ROOT/$f ]] || continue
      mkdir -p "$1/$(dirname "$f")"
      cp "$ROOT/$f" "$1/$f"
    done
  git -C "$1" add -A
  git -C "$1" commit -q --allow-empty -m 'Working copy'
  if [[ $(git -C "$1" branch --show-current) != main ]]; then
    git -C "$1" branch -f main HEAD
  fi
  # shellcheck disable=SC2034  # for the caller
  in1_args="IN-1-REPO=$1 IN-1-REF=$(git -C "$1" branch --show-current)"
  # shellcheck disable=SC2034  # for the caller
  in1_main_args="IN-1-REPO=$1"
}

# The checks that install in-1 itself need in-1.mk in the makes clone
have-in1-mk() {
  [[ -f $IN1_MAKES_REPO/in-1.mk ]] && return 0
  pass "$1: makes has no in-1.mk; skipped"
  return 1
}

[[ -d $IN1_MAKES_REPO ]] ||
  die "makes clone not found at '$IN1_MAKES_REPO' (run 'make test')"

cd "$ROOT"
