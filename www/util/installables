#!/usr/bin/env perl

use strict;
use warnings;

my ($makes_dir, $in1, $tools_file, $support_report, $langs_file,
    $release_file, $commit_file) = @ARGV;
die "Usage: $0 MAKES-DIR IN-1 TOOLS-MK SUPPORT-REPORT LANGS-YAML " .
    "RELEASES-TSV COMMITS-TSV\n" unless defined $commit_file;

my $in1_source = slurp($in1);
my ($filter) = $in1_source =~ /^tool_filter='([^']*)'/m;
die "Can't find tool_filter in '$in1'\n" unless defined $filter;
my %skip = map { $_ => 1 } split /\s+/, $filter;

my %metadata;
for (split /\n/, slurp($tools_file)) {
    next unless /^([a-z0-9.+_-]+)-([a-z-]+) :=\s*(.*)$/;
    $metadata{$1}{$2} = $3;
}

my %upstream_support;
my $section = '';
for (split /\n/, slurp($support_report)) {
    if (/^## Both completion and man pages/) {
        $section = 'both';
    }
    elsif (/^## Completion only/) {
        $section = 'completion';
    }
    elsif (/^## Man pages only/) {
        $section = 'man';
    }
    elsif (/^## /) {
        $section = '';
    }
    next unless $section && /^\| `([^`]+)` \|/;
    my $name = $1;
    $upstream_support{$name}{completion} = 1
        if $section eq 'both' || $section eq 'completion';
    $upstream_support{$name}{man} = 1
        if $section eq 'both' || $section eq 'man';
}

my %languages;
my $slug = '';
for (split /\n/, slurp($langs_file)) {
    $slug = $1 if /^  slug:\s*(\S+)/;
    $languages{$slug} = 1 if $slug && /^  makes:\s*true\s*$/;
}

my %release_dates;
for (split /\n/, slurp($release_file)) {
    next if /^\s*(?:#|$)/;
    my ($name, $version, $date) = split /\t/;
    die "Invalid release date row: $_\n"
        unless $name && $version && $date =~ /^\d{4}-\d{2}-\d{2}$/;
    $release_dates{$name}{$version} = $date;
}

my %commit_dates;
for (split /\n/, slurp($commit_file)) {
    next if /^\s*(?:#|$)/;
    my ($repo, $date) = split /\t/;
    die "Invalid commit date row: $_\n"
        unless $repo && $date =~ /^\d{4}-\d{2}-\d{2}$/;
    $commit_dates{$repo} = $date;
}

my %cache;
my @rows;
for my $file (sort glob "$makes_dir/*.mk") {
    (my $name = $file) =~ s{.*/|\.mk$}{}g;
    next if $skip{$name};
    my $data = module_data($name, {});
    my $completion = support_state($name, 'completion');
    my $manual = support_state($name, 'man');
    my $date = release_date($name, $data->{version}, {});
    my $date_source = $date ? 'release' : '';
    if (!$date && $data->{repo} && $commit_dates{$data->{repo}}) {
        $date = $commit_dates{$data->{repo}};
        $date_source = 'commit';
    }
    push @rows, {
        name => $name,
        site => $data->{site},
        version => $data->{version},
        release => $data->{release},
        date => $date,
        date_source => $date_source,
        repo => $data->{repo},
        by => $data->{auth},
        description => $data->{desc},
        type => $languages{$name} ? 'Language' : 'Tool',
        completion => $completion,
        manual => $manual,
    };
}

