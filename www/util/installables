my $order = 0;
for my $row (@rows) {
    $order++;
    my $name = html($row->{name});
    my $site = html($row->{site});
    my $version = html($row->{version});
    my $release = html($row->{release});
    my $date = $row->{date};
    my $date_source = $row->{date_source};
