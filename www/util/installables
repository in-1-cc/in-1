    print qq{      <td class="installable-support" };
    print qq{data-sort-value="$completion_sort">};
    print qq{$completion_html</td>\n};
    print qq{      <td class="installable-support" };
    print qq{data-sort-value="$manual_sort">$manual_html</td>\n};
    print qq{      <td class="installable-description" };
    print qq{data-sort-value="$description">};
    print qq{$description</td>\n};
    print qq{    </tr>\n};
}

