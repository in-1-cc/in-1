sub module_data {
    my ($name, $seen) = @_;
    return $cache{$name} if $cache{$name};
    return empty_data($name) if $seen->{$name}++;

    my $file = "$makes_dir/$name.mk";
    return empty_data($name) unless -f $file;
    my $source = slurp($file);
    my $preamble = $source;
    $preamble =~ s/^ifndef [A-Z0-9_-]+-LOADED\b.*//ms;
    my @header_urls = map { trim_url($_) }
        $preamble =~ m{^#\s*(https?://\S+)}mg;
    my $logical = $source;
    $logical =~ s/\\\n[ \t]*/ /g;

    my %variables;
    my @versions;
    my @assignment_urls;
    for my $line (split /\n/, $logical) {
        next unless $line =~ /^([A-Za-z0-9_-]+)\s*(\?=|:=|=)\s*(.*?)\s*$/;
        my ($key, $operator, $raw) = ($1, $2, $3);
        next if $operator eq '?=' && exists $variables{$key};
        my $value = expand($raw, \%variables);
        $variables{$key} = $value;
        push @versions, [$key, $value]
            if $key =~ /-VERSION(?:-|$)/;
        push @assignment_urls, map { trim_url($_) }
            $value =~ m{(https?://[^\s'"()]+)}g;
    }

    my @includes = $source =~
        /^include \$\(MAKES\)\/([a-z0-9.+_-]+)\.mk\s*$/mg;
    my $parent = @includes ? module_data($includes[0], {%$seen}) : undef;
    my $own_version = find_version($name, \@versions, $source);
    my $version = $own_version;
    $version ||= $parent->{version} if $parent;
    $version ||= 'Unpinned';

    my @site_urls = (@header_urls, @assignment_urls);
    my $repo = $metadata{$name}{repo} || '';
    $repo ||= $parent->{repo} if $parent;

    my $own_site = $metadata{$name}{site} || '';
    my $site = $own_site;
    $site ||= $parent->{site} if $parent;
    $site ||= $repo || 'https://github.com/makeplus/makes';

    my $release = find_release(\@assignment_urls, $repo, $version);
    $release ||= $parent->{release}
        if $parent && !$own_version && !$own_site;

    my $description = $metadata{$name}{desc} || '';
    my $words = () = $description =~ /\S+/g;
    die "Description for '$name' must contain 3 to 10 words\n"
        unless $words >= 3 && $words <= 10;
    my $committer = $metadata{$name}{auth} || '';
    die "Invalid GitHub ID for '$name'\n"
        unless $committer =~ /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/;

    return $cache{$name} = {
        version => $version,
        site => $site,
        release => $release,
        repo => $repo,
        auth => $committer,
        desc => $description,
        includes => \@includes,
    };
}

sub empty_data {
    my ($name) = @_;
    return {
        version => 'Unpinned',
        site => 'https://github.com/makeplus/makes',
        release => '',
        repo => '',
        auth => '',
        desc => '',
        includes => [],
    };
}

sub find_version {
    my ($name, $versions, $source) = @_;
    (my $prefix = uc $name) =~ s/[^A-Z0-9]+/-/g;

    for my $item (@$versions) {
        return clean_version($item->[1])
            if $item->[0] eq "$prefix-VERSION" &&
                clean_version($item->[1]);
    }
    for my $item (@$versions) {
        next if $item->[0] =~ /-VERSION-/;
        my $version = clean_version($item->[1]);
        return $version if $version;
    }

    my @platform = map { clean_version($_->[1]) }
        grep { $_->[0] =~ /^\Q$prefix\E-VERSION-/ } @$versions;
    my %unique;
    @platform = grep { $_ && !$unique{$_}++ } @platform;
    return join(', ', sort @platform) if @platform;

    if ($source =~ /^\Q$prefix\E-COMMIT\s*\?=\s*(\S+)/m) {
        return $1;
    }
    return 'main' if $source =~ /\@main\b/;
    return '';
}

sub support_state {
    my ($name, $kind) = @_;
    my $metadata_kind = $kind eq 'completion' ? 'comp' : $kind;
    return 'Yes' if $name eq 'in-1';
    return 'Yes' if $metadata{$name}{$metadata_kind};
    return 'Available' if $upstream_support{$name}{$kind};
    return 'No';
}

sub release_date {
    my ($name, $version, $seen) = @_;
    return $release_dates{$name}{$version}
        if $release_dates{$name}{$version};
    return '' if $seen->{$name}++;
    my $data = module_data($name, {});
    for my $parent (@{$data->{includes}}) {
        my $date = release_date($parent, $version, {%$seen});
        return $date if $date;
    }
    return '';
}

sub clean_version {
    my ($version) = @_;
    return '' unless defined $version;
    return 'latest' if $version =~ /\$\(shell\b/;
    return '' if $version =~ /\$\(/;
    $version =~ s/^\s+|\s+$//g;
    return $version;
}

sub find_release {
    my ($urls, $site, $version) = @_;
    return '' if $version =~ /^(?:latest|main|Unpinned)$/;
    for my $url (@$urls) {
        my $repo = github_repo($url) or next;
        if ($url =~ m{/releases/download/([^/]+)}) {
            my $tag = $1;
            return "$repo/releases/tag/$tag"
                if $tag !~ /\$/ && index($tag, $version) >= 0;
        }
    }
    return $site if $site =~ m{/(?:releases|tags)/?$};
    my $site_repo = github_repo($site);
    return $site_repo ? "$site_repo/releases" : '';
}

sub github_repo {
    my ($url) = @_;
    return '' unless defined $url;
    $url =~ s{^https://raw\.githubusercontent\.com/}{https://github.com/};
    return '' unless $url =~
        m{^https://(?:www\.)?github\.com/([^/]+)/([^/#?]+)};
    my ($owner, $repo) = ($1, $2);
    $repo =~ s/\.git$//;
    return "https://github.com/$owner/$repo";
}

sub expand {
    my ($value, $variables) = @_;
    for (1 .. 10) {
        my $before = $value;
        $value =~ s{\$\(([A-Za-z0-9_-]+)\)}{
            exists $variables->{$1} ? $variables->{$1} : "\$($1)"
        }gex;
        last if $value eq $before;
    }
    return $value;
}

sub trim_url {
    my ($url) = @_;
    $url =~ s{[.,;:)]+$}{};
    return $url;
}

sub html {
    my ($text) = @_;
    $text //= '';
    $text =~ s/&/&amp;/g;
    $text =~ s/</&lt;/g;
    $text =~ s/>/&gt;/g;
    $text =~ s/"/&quot;/g;
    return $text;
}

sub support_html {
    my ($value) = @_;
    my %display = (
        Yes => ['support-yes', 'Yes', '&#8730;'],
        Available => [
            'support-available',
            'Supported upstream, not installed by in-1',
            '&#8730;*',
        ],
        No => ['support-no', 'No', 'X'],
    );
    my ($class, $label, $symbol) = @{$display{$value}};
    return qq{<span class="$class" aria-label="$label" } .
        qq{title="$label">$symbol</span>};
}

sub by_html {
    my ($committer) = @_;
    my $login = html($committer);
    my $avatar = "https://github.com/$login.png?size=64";
    my $profile = "https://github.com/$login";
    return qq{      <td class="installable-by" } .
        qq{data-sort-value="$login"><a href="$profile" } .
        qq{aria-label="GitHub committer $login" title="\@$login">} .
        qq{<img src="$avatar" alt="\@$login" loading="lazy"></a></td>\n};
}

sub type_html {
    my ($type) = @_;
    my $class = lc $type;
    my $icon = $type eq 'Language' ? '&lt;/&gt;' : '&#128296;';
    return qq{<span class="type-icon type-$class" role="img" } .
        qq{aria-label="$type" title="$type">} .
        qq{<span aria-hidden="true">$icon</span></span>};
}

sub support_sort {
    my ($value) = @_;
    return $value eq 'Yes' ? 2 : $value eq 'Available' ? 1 : 0;
}

sub slurp {
    my ($file) = @_;
    open my $handle, '<', $file or die "Can't read '$file': $!\n";
    local $/;
    return <$handle>;
}
