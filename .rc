# shellcheck shell=bash
#
# Sets up the in-1 command in your shell.
#
# Add this line to your shell rc file (bash, zsh or fish):
#
#   source /path/to/in-1/.rc
#
# For an in-1 installed with `in-1 --local in-1`, let the command
# find its own .rc, so the line survives version changes:
#
#   source <(in-1 --rc)     # bash / zsh
#   in-1 --rc | source      # fish
#
# (Or, for the current shell only, `source <(curl -sL in-1.cc) in-1`
# does the same for the in-1 it installs.)  Then:
#
#   in-1 rust node    # install tools into this shell session
#   in-1 --local jq   # install jq under ~/.local for keeps
#   in-1 -U jq        # remove that again
#   in-1 --update     # update in-1 and makes
#   in-1 -R           # remove makes/, log/, local/ and cache/
#   in-1 -R rust      # same, then install rust from scratch
#   in-1 --help
#   man in-1
#
# IN1_ROOT is left alone when it is already set; otherwise it becomes
# the in-1 clone this file lives in, or, for a --local installed in-1
# (this file under PREFIX/share/in-1/<v>/cache/in-1-<v>/), the stable
# PREFIX/share/in-1/local.  makes, the session installs (local/), logs
# and the download cache go under it.

test -n "$BASH_VERSION$ZSH_VERSION" && eval '
if [ -n "${BASH_VERSION-}" ]; then
  _in1_shell=bash
  _in1_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
else
  _in1_shell=zsh
  _in1_dir=$(cd "$(dirname "$0")" && pwd -P)
fi
if [ -z "${IN1_ROOT-}" ]; then
  case $_in1_dir in
    */share/in-1/*/cache/in-1-*)
      IN1_ROOT=${_in1_dir%/share/in-1/*}/share/in-1/local;;
    *) IN1_ROOT=$_in1_dir;;
  esac
fi
export IN1_ROOT

case ":$PATH:" in
  *":$_in1_dir/bin:"*) ;;
  *) PATH=$_in1_dir/bin:$PATH;;
esac
export PATH

case ":${MANPATH-}:" in
  *":$_in1_dir/man:"*) ;;
  *) MANPATH=$_in1_dir/man:$(manpath 2>/dev/null);;
esac
export MANPATH

eval "$(command in-1 --complete "$_in1_shell" 2>/dev/null)"

# Wrap the in-1 command in a function so that session installs can
# modify the current shell environment.  The first argument that is
# not --update or -R/--reset decides: a tool name means a session
# install.
in-1() {
  local first=""
  for first in "$@"; do
    case $first in --update|-R|--reset) continue;; esac
    break
  done
  case $first in
    ""|-*) command in-1 "$@";;
    *)
      if [ -n "${ZSH_VERSION-}" ]; then
        eval "$(command in-1 --env zsh "$@")"
      else
        eval "$(command in-1 --env bash "$@")"
      fi
      ;;
  esac
}

unset _in1_shell _in1_dir
return 0
'

test -n "$FISH_VERSION" && eval '
set -g _in1_dir (cd (dirname (status filename)) && pwd -P)
if test -z "$IN1_ROOT"
  if string match -q "*/share/in-1/*/cache/in-1-*" $_in1_dir
    set -gx IN1_ROOT (string replace -r \
      "/share/in-1/[^/]*/cache/in-1-[^/]*\$" /share/in-1/local $_in1_dir)
  else
    set -gx IN1_ROOT $_in1_dir
  end
end

contains -- $_in1_dir/bin $PATH
or set -gx PATH $_in1_dir/bin $PATH

contains -- $_in1_dir/man $MANPATH
or set -gx MANPATH $_in1_dir/man (manpath 2>/dev/null | string split :)

command in-1 --complete fish 2>/dev/null | source

function in-1
  set -l first ""
  for first in $argv
    if not contains -- "$first" --update -R --reset
      break
    end
  end
  if test -z "$first"; or string match -q -- "-*" "$first"
    command in-1 $argv
  else
    set -l envfile (mktemp)
    if command in-1 --env fish $argv > $envfile
      source $envfile
      rm -f $envfile
    else
      rm -f $envfile
      return 1
    end
  end
end

set -e _in1_dir
'

# No `return` in the fish block: when this file is sourced from inside
# a function (the in-1 extra does that), a fish `return` would leave
# that function instead of this file.  bash and zsh returned above.
test -n "$FISH_VERSION" ||
  echo "ERROR: in-1/.rc requires bash, zsh or fish" >&2
test -n "$FISH_VERSION"

# vim: ft=sh:
