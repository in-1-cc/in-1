# shellcheck shell=bash
#
# Sets up the in-1 command in your shell.
#
# Add this line to your shell rc file (bash, zsh or fish):
#
#   source /path/to/in-1/.rc
#
# For an in-1 installed with `in-1 --local in-1`, let the command
# find its own .rc, so the line survives version changes:
#
#   source <(in-1 --rc)     # bash / zsh
#   in-1 --rc | source      # fish
#
# (Or, for the current shell only, `source <(curl -sL in-1.cc) in-1`
# does the same for the in-1 it installs.)  Then:
#
#   in-1 rust node       # install alongside in-1
#   in-1 --temp jq       # install under $TMPDIR/in-1
#   in-1 --local jq      # install jq under ~/.local for keeps
#   in-1 --uninstall jq  # remove that again
#   in-1 --update        # update in-1 and makes
#   in-1 --reset         # remove managed tools and state, keeping in-1
#   in-1 --reset rust    # same, then install rust from scratch
#   in-1 --help
#   man in-1
#
# IN1_ROOT is left alone when it is already set; otherwise it becomes
# the in-1 clone this file lives in, or, for a --local installed in-1
# (this file under PREFIX/share/in-1/<v>/cache/in-1-<v>/), the stable
# PREFIX/share/in-1/local. Makes, logs and downloads go under it;
# this state directory does not select the installation prefix.

# Detect Bash/Zsh by their builtins without reading unset variables.
type shopt >/dev/null 2>&1 || type setopt >/dev/null 2>&1 && eval '
if [ -n "${BASH_VERSION-}" ]; then
  _in1_shell=bash
  _in1_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
else
  _in1_shell=zsh
  _in1_dir=$(cd "$(dirname "$0")" && pwd -P)
fi
_in1_bin=$_in1_dir/bin
case $_in1_dir in
  */share/in-1/*/cache/in-1-*)
    _in1_bin=${_in1_dir%/share/in-1/*}/bin;;
esac
if [ -z "${IN1_ROOT-}" ]; then
  case $_in1_dir in
    */share/in-1/*/cache/in-1-*)
      IN1_ROOT=${_in1_dir%/share/in-1/*}/share/in-1/local;;
    *) IN1_ROOT=$_in1_dir;;
  esac
fi
export IN1_ROOT

case ":$PATH:" in
  *":$_in1_bin:"*) ;;
  *) PATH=$_in1_bin:$PATH;;
esac
# An installed copy must not expose its implementation checkout on PATH.
case $_in1_dir in
  */share/in-1/*/cache/in-1-*)
    _in1_rest=$PATH
    PATH=$_in1_bin
    while :; do
      _in1_part=${_in1_rest%%:*}
      case $_in1_part in
        "$_in1_bin"|"${_in1_bin%/bin}"/share/in-1/*/bin) ;;
        *) PATH=$PATH:$_in1_part;;
      esac
      case $_in1_rest in
        *:*) _in1_rest=${_in1_rest#*:};;
        *) break;;
      esac
    done;;
esac
export PATH

case ":${MANPATH-}:" in
  *":$_in1_dir/man:"*) ;;
  *) MANPATH=$_in1_dir/man:$(manpath 2>/dev/null);;
esac
export MANPATH

eval "$(command in-1 --complete "$_in1_shell" 2>/dev/null)"

# Wrap the in-1 command in a function so that session installs can
# modify the current shell environment.  The first argument that is
# not --update, --reset or a quiet flag decides: a tool name means a session
# install.
in-1() {
  local first="" in1_status in1_shell=bash
  [ -n "${ZSH_VERSION-}" ] && in1_shell=zsh
  for first in "$@"; do
    case $first in --update|--reset|--local|--temp|-q|--quiet) continue;; esac
    break
  done
  case $first in
    ""|-*) command in-1 "$@";;
    *)
      local in1_output
      in1_output=$(command in-1 --env "$in1_shell" "$@") || return $?
      eval "$in1_output";;
  esac
  in1_status=$?
  # Preserve the first occurrence of every component, including an empty one.
  local in1_rest=$PATH in1_part in1_path="" in1_seen=:
  local in1_sep=""
  while :; do
    in1_part=${in1_rest%%:*}
    case $in1_seen in
      *":$in1_part:"*) ;;
      *)
        in1_path=$in1_path$in1_sep$in1_part
        in1_sep=:
        in1_seen=$in1_seen$in1_part:;;
    esac
    case $in1_rest in *:*) in1_rest=${in1_rest#*:};; *) break;; esac
  done
  PATH=$in1_path
  export PATH
  return "$in1_status"
}

unset _in1_shell _in1_dir _in1_bin _in1_rest _in1_part
return 0
'

test -n "$FISH_VERSION" && eval '
set -g _in1_dir (cd (dirname (status filename)) && pwd -P)
set -g _in1_bin $_in1_dir/bin
if string match -q "*/share/in-1/*/cache/in-1-*" $_in1_dir
  set _in1_bin (string replace -r \
    "/share/in-1/[^/]*/cache/in-1-[^/]*\$" /bin $_in1_dir)
end
if test -z "$IN1_ROOT"
  if string match -q "*/share/in-1/*/cache/in-1-*" $_in1_dir
    set -gx IN1_ROOT (string replace -r \
      "/share/in-1/[^/]*/cache/in-1-[^/]*\$" /share/in-1/local $_in1_dir)
  else
    set -gx IN1_ROOT $_in1_dir
  end
end

contains -- $_in1_bin $PATH
or set -gx PATH $_in1_bin $PATH
if string match -q "*/share/in-1/*/cache/in-1-*" $_in1_dir
  set -l paths
  set -l prefix (string replace -r "/bin\$" "" $_in1_bin)
  for entry in $PATH
    if test "$entry" != "$_in1_bin"; and not string match -q \
        "$prefix/share/in-1/*/bin" "$entry"
      set -a paths "$entry"
    end
  end
  set -gx PATH $_in1_bin $paths
end

contains -- $_in1_dir/man $MANPATH
or set -gx MANPATH $_in1_dir/man (manpath 2>/dev/null | string split :)

command in-1 --complete fish 2>/dev/null | source

function in-1
  set -l first ""
  for first in $argv
    if not contains -- "$first" --update --reset --local --temp -q --quiet
      break
    end
  end
  if test -z "$first"; or string match -q -- "-*" "$first"
    command in-1 $argv
  else
    set -l envfile (mktemp)
    if command in-1 --env fish $argv > $envfile
      source $envfile
      rm -f $envfile
    else
      rm -f $envfile
      return 1
    end
  end
end

set -e _in1_dir
set -e _in1_bin
'

# No `return` in the fish block: when this file is sourced from inside
# a function (the in-1 extra does that), a fish `return` would leave
# that function instead of this file.  bash and zsh returned above.
test -n "$FISH_VERSION" || eval '
  test ! -t 2 || printf "\033[31m" >&2
  printf X >&2
  test ! -t 2 || printf "\033[0m" >&2
  printf " in-1/.rc requires bash, zsh or fish\n" >&2
'
test -n "$FISH_VERSION"

# vim: ft=sh:
