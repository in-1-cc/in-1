#!/usr/bin/env bash

# in-1 - install dev tools for the current shell session
#
# https://in-1.cc/
# https://github.com/in-1-cc/in-1
#
# Uses https://github.com/makeplus/makes to install each tool.

set -euo pipefail

IN1_FALLBACK_VERSION=0.1.0
MAKES_REPO_DEFAULT=https://github.com/makeplus/makes

# Vars that make sets for its own use, or that must never leak into an
# interactive shell (local.mk exports TMPDIR, init.mk exports LANG):
env_denylist='MAKEFLAGS MFLAGS MAKELEVEL MAKE_TERMOUT MAKE_TERMERR
GNUMAKEFLAGS MAKEOVERRIDES MAKES_QUIET MAKES_CACHE_DIR MAKES_LOCAL_DIR
CMD SHLVL PWD OLDPWD _ SHELL SHELLOPTS BASHOPTS TMPDIR LANG LC_ALL
HOME TERM PS1 COLUMNS LINES'

tool_filter='agents clean claude docker docker-or-podman git help init
local podman shell'

self_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)

# Set by --update (or IN1_UPDATE); update in-1 and makes first
update=''

# Set by --reset; remove managed tools and cached state, keeping in-1
reset=''

# Set by -q or --quiet; suppress output from successful operations
quiet=''

# Prefix selection is independent of shell output mode and state storage.
placement=normal
prefix=''

main() {
  local mode=run shell='' arg upd_flag='' show='' list='' output pattern
  local -a tools=()

  [[ ${IN1_UPDATE-} ]] && update=1

  while [[ $# -gt 0 ]]; do
    arg=$1; shift
    case $arg in
      --env)
        mode='env'
        [[ $# -gt 0 ]] || die "--env requires a shell name"
        shell=$1; shift
        ;;
      --local)
        [[ $placement != temp ]] || die "--local and --temp cannot be combined"
        placement=local
        [[ $mode != run ]] || mode=local;;
      --temp)
        [[ $placement != local ]] || die "--local and --temp cannot be combined"
        placement=temp;;
      --show) show=1;;
      --) tools+=("$@"); break;;
      --list) list=1;;
      --complete)
        [[ $# -gt 0 ]] || die "--complete requires a shell name"
        do-complete "$1"; return 0
        ;;
      --uninstall) mode=uninstall;;
      -q|--quiet) quiet=1;;
      --update) update=1; upd_flag=1;;
      --reset) reset=1;;
      --version)
        printf 'in-1 %s\n' "$(get-version)" | to-user "$mode" "$shell"
        return 0
        ;;
      --rc)
        printf 'source %s\n' "$(sq "$self_root/.rc")" |
          to-user "$mode" "$shell"
        return 0
        ;;
      --help|-h)
        show-help "$mode" "$shell"
        return 0
        ;;
      -*) die "Unknown option '$arg'. Try: in-1 --help";;
      *) tools+=("$arg");;
    esac
  done

  if [[ $list && $show ]]; then
    die "--list and --show cannot be combined"
  fi

  if [[ ! $list || $reset ]]; then
    local -a remaining=()
    for arg in ${tools[@]+"${tools[@]}"}; do
      if [[ $arg == PREFIX=* ]]; then
        [[ $placement != temp ]] || die "--temp takes no PREFIX=DIR argument"
        PREFIX=${arg#*=}
      else
        remaining+=("$arg")
      fi
    done
    tools=( ${remaining[@]+"${remaining[@]}"} )
  fi
  prefix=$(resolve-prefix) || return $?
  check-prefix || return $?

  if [[ $list ]]; then
    [[ ${#tools[@]} -le 1 ]] || die "--list takes at most one pattern"
    pattern=${tools[0]-}
    validate-pattern --list "$pattern"
    output=$(list-tools | filter-rows "$pattern") || return $?
    [[ -z $output ]] ||
      printf '%s\n' "$output" | to-user "$mode" "$shell" | run-pager || true
    return 0
  fi

  if [[ $show ]]; then
    [[ $reset || $upd_flag ]] &&
      die "--show takes no --reset or --update"
    [[ -z $shell ]] || shell=$(check-shell "$shell")
    output=$(do-show ${tools[@]+"${tools[@]}"}) || return $?
    [[ -z $output ]] || printf '%s\n' "$output" | to-user "$mode" "$shell"
    return 0
  fi

  if [[ $mode == uninstall ]]; then
    [[ $reset || $upd_flag ]] &&
      die "--uninstall takes no --reset or --update"
    do-uninstall ${tools[@]+"${tools[@]}"}
    return
  fi

  # A bare update or reset (no tools) does just that; a bare reset
  # does not clone makes again
  if [[ ${#tools[@]} -eq 0 && ($update || $reset) ]]; then
    if [[ $update ]]; then
      prepare-root
    else
      check-prereqs
      set-globals
      do-reset
    fi
    return 0
  fi

  case $mode in
    env) do-env "$shell" ${tools[@]+"${tools[@]}"};;
    local) do-local "$shell" ${tools[@]+"${tools[@]}"};;
    run) do-run ${tools[@]+"${tools[@]}"};;
  esac
}

usage() (
  cat <<'...'
in-1 - instant dev tools for your current shell

Usage:
  source <(curl -sL in-1.cc) [OPTIONS] TOOL... [VAR=VALUE]...  # bash / zsh
  curl -sL in-1.cc | source - [OPTIONS] TOOL... [VAR=VALUE]... # fish
  source <(curl -sL in-1.cc) in-1                     # in-1 itself

  in-1 TOOL... [VAR=VALUE]...  Install tools under the selected prefix
  in-1 --local TOOL...         Install tools under PREFIX for keeps
  in-1 --temp TOOL...          Install tools under $TMPDIR/in-1
  in-1 --uninstall TOOL...     Remove tools from their install prefix
  in-1 --list [PATTERN]        List available tools and aliases
  in-1 --show [PATTERN]        Show installed tool versions and locations
  in-1 --env SHELL TOOL...     Print env setup code for SHELL
                               (bash, zsh or fish)
  in-1 --complete SHELL        Print in-1 command completion for SHELL
  in-1 --rc                    Print the shell setup line (source it)
  in-1 -q|--quiet ARGS...      Suppress output on success
  in-1 --update [ARGS]         Update in-1 and makes, then continue
  in-1 --reset [ARGS]          Remove managed tools and state; keep in-1
  in-1 --version               Print the in-1 version
  in-1 --help                  Show this help

Each install goes under <prefix>/share/<tool>/<version> and gets a
command wrapper in <prefix>/bin, which is the single dir put on PATH.
So `which <cmd>` is always <prefix>/bin/<cmd>.  The primary command
of a tool also gets a version-specific wrapper, <cmd>-<version>.

--list and --show accept an optional grep -E pattern, matched against
each output line. Quote patterns, e.g. 'in-1 --list "^(rust|node)$"'.
--show prints tool, version and installation directory, separated by tabs.
Install, --show, --uninstall and --reset all use the same prefix.
By default it matches the public bin directory of the installed in-1.
Without an installed in-1 it is $TMPDIR/in-1 (default /tmp/in-1).
--local selects a persistent prefix (~/.local when none is installed).
PREFIX=DIR overrides the environment and either default.
--temp always selects $TMPDIR/in-1, ignores inherited PREFIX, and cannot
be combined with --local or a PREFIX=DIR argument.

A NAME=VALUE argument is passed through to makes as a variable, so
pin a version with its makes variable, e.g.
'in-1 perl PERL-VERSION=5.42.0'.  PREFIX=DIR is the exception: it
sets the install prefix, like the PREFIX environment variable.

in-1 is itself a tool: 'in-1' as a TOOL (the one-liner with in-1,
say) installs the in-1 command for this shell session, with its
shell function, man page and completion; 'in-1 --local in-1'
installs it for keeps.  Then 'source <(in-1 --rc)' (bash, zsh) or
'in-1 --rc | source' (fish) in your shell rc file gives every new
shell the same.  'source <(curl -sL in-1.cc) --local in-1' does both
the install and the setup of the current shell in one go.

An install checks whether in-1 is behind its origin and says so.
It automatically updates makes when its clone is behind.  --update
also updates in-1.  --reset starts over: it removes everything in-1
put in the selected prefix, except in-1 itself, plus Makes, logs and
downloads under IN1_ROOT. Unrelated files and external caches stay.

Environment variables:
  IN1_ROOT        State directory for makes/, log/ and cache/.
                  Default: PREFIX/share/in-1/local. Does not select
                  the install prefix. --temp ignores inherited state.
  IN1_CACHE       Download cache dir; default '$IN1_ROOT/cache'
  PREFIX          Install prefix; normally the installed in-1 prefix.
                  Fresh installs default to '$TMPDIR/in-1'. --local
                  falls back to '~/.local' ('/usr/local' as root).
  IN1_REPO        in-1 repo URL to clone
  IN1_MAKES_REPO  makes repo URL to clone
  IN1_VERSION     in-1 version (git ref) to use
  IN1_UPDATE      Set to 1 for the same effect as --update
  IN1_OFFLINE     Set to 1 to skip update checks
  IN1_VERBOSE     Set to 1 to stream full install output instead of
                  the quiet progress lines

See 'man in-1' or https://in-1.cc/doc/ for full documentation.
...
)

show-help() (  # $1=mode $2=shell
  usage | to-user "$1" "$2" | run-pager || true
)

# Pass text meant for the user (--list, --show, --help, --version) through.
# In --env mode stdout is shell code that the caller evals, so the
# text is wrapped in a printf for the caller's shell to run; it still
# lands on the user's stdout.  That is what the one-liner hits with
# 'source <(curl -sL in-1.cc) --list'.
to-user() (  # $1=mode $2=shell
  text=''
  if [[ $1 == env ]]; then
    text=$(cat)
    if [[ $2 == fish ]]; then
      printf "printf '%%s\\\\n' %s\n" "$(fq "$text")"
    else
      printf "printf '%%s\\\\n' %s\n" "$(sq "$text")"
    fi
  else
    cat
  fi
)

error() {
  local red='' normal=''
  if [[ -t 2 ]]; then
    red=$'\033[31m'; normal=$'\033[0m'
  fi
  local message
  for message; do
    printf '%sX%s %s\n' "$red" "$normal" "$message" >&2
  done
}
die() { error "$@"; exit 1; }
success() (
  [[ $quiet ]] && return 0
  green='' normal=''
  if [[ -t 2 ]]; then
    green=$'\033[32m'; normal=$'\033[0m'
  fi
  for message; do
    printf '%s√%s %s\n' "$green" "$normal" "$message" >&2
  done
)
note() (
  [[ $quiet ]] && return 0
  yellow='' normal=''
  if [[ -t 2 ]]; then
    yellow=$'\033[33m'; normal=$'\033[0m'
  fi
  for message; do
    printf '%s⚠︎%s %s\n' "$yellow" "$normal" "$message" >&2
  done
)

# Page stdin when writing to a terminal.  Honor PAGER; use
# 'less -FRX' when PAGER is unset or exactly 'less'.
run-pager() (
  if [[ ! -t 1 ]]; then
    cat
    return
  fi
  pager=${PAGER-}
  if [[ -z $pager || $pager == less ]]; then
    if command -v less >/dev/null 2>&1; then
      less -FRX
    else
      cat
    fi
  else
    # shellcheck disable=SC2086  # PAGER may carry its own arguments
    $pager
  fi
)

# The version of the in-1 clone at $1 (default: the one running)
get-version() (  # [$1=clone-dir]
  dir=${1:-$self_root}
  # Guarded: a non-clone dir inside another repo must not describe it
  if [[ -e $dir/.git ]]; then
    git -C "$dir" describe --tags --always 2>/dev/null && return 0
  fi
  printf '%s\n' "$IN1_FALLBACK_VERSION"
)

uc() ( printf '%s' "$1" | tr '[:lower:]' '[:upper:]' )

join-colon() ( IFS=:; printf '%s' "$*" )

tilde-expand() (
  # shellcheck disable=SC2088  # literal leading tilde is the point
  case $1 in
    '~') printf '%s' "$HOME";;
    '~/'*) printf '%s/%s' "$HOME" "${1#'~/'}";;
    *) printf '%s' "$1";;
  esac
)

# Absolute path, tilde-expanded, with relative paths anchored to the
# caller's current directory (not the internal makes root)
abs-path() (
  p=''
  p=$(tilde-expand "$1")
  case $p in
    /*) printf '%s' "$p";;
    *) printf '%s/%s' "$PWD" "$p";;
  esac
)

# Current time in seconds with a fractional part when available
now() (
  if [[ -n ${EPOCHREALTIME:-} ]]; then
    printf '%s' "${EPOCHREALTIME/,/.}"
  else
    date +%s.%N 2>/dev/null || date +%s
  fi
)

# Elapsed seconds between two now() readings, as N.NN
elapsed() (  # $1=start $2=end
  awk -v a="$1" -v b="$2" 'BEGIN { d = b - a; if (d < 0) d = 0
    printf "%.2f", d }'
)

# Look up a variable from share/tools.mk (flat "key := value" lines).
# Values are literal; make is not involved so '*' etc. do not expand.
meta() (  # $1=key -> value ('' if unset)
  f=$self_root/share/tools.mk line='' key=$1 v=''
  [[ -f $f ]] || return 0
  while IFS= read -r line; do
    line=${line%%#*}
    case $line in
      "$key"[[:space:]]*:=*|"$key":=*) ;;
      *) continue;;
    esac
    v=${line#*:=}
    v=${v#"${v%%[![:space:]]*}"}
    v=${v%"${v##*[![:space:]]}"}
    printf '%s' "$v"
    return 0
  done < "$f"
)

# Emit alias/tool pairs from the command names in each -bin entry.
alias-pairs() (
  f=$self_root/share/tools.mk line='' k='' v='' name='' tool=''
  [[ -f $f ]] || return 0
  while IFS= read -r line; do
    line=${line%%#*}
    case $line in
      *-bin[[:space:]]*:=*|*-bin:=*) ;;
      *) continue;;
    esac
    k=${line%%:=*}
    k=${k//[[:space:]]/}
    tool=${k%-bin}
    v=${line#*:=}
    read -r -a names <<< "$v"
    for name in "${names[@]}"; do
      [[ $name == "$tool" ]] && continue
      printf '%s %s\n' "$name" "$tool"
    done
  done < "$f"
)

alias-tool() (  # $1=alias -> tool ('' if unset)
  while read -r name tool; do
    if [[ $name == "$1" ]]; then
      printf '%s' "$tool"
      return 0
    fi
  done < <(alias-pairs)
)

check-prereqs() (
  cmd=''
  for cmd in git curl make; do
    command -v "$cmd" >/dev/null 2>&1 ||
      die "'$cmd' is required but not found in PATH"
  done
  case $(make --version 2>/dev/null) in
    *GNU\ Make*) ;;
    *) die "GNU make is required";;
  esac
)

# Find the public prefix, never the implementation clone's bin directory.
installed-prefix() (
  case $self_root in
    */share/in-1/*/cache/in-1-*)
      printf '%s' "${self_root%/share/in-1/*}"
      return;;
  esac
  # A fresh bootstrap follows an existing public installation on PATH.
  command_path=$(type -P in-1) || return 0
  command_path=$(abs-path "$command_path")
  case $command_path in
    */share/in-1/*/cache/in-1-*/bin/in-1)
      candidate=${command_path%/share/in-1/*};;
    */bin/in-1) candidate=${command_path%/bin/in-1};;
    *) return 0;;
  esac
  if is-wrapper-under "$candidate/bin/in-1" "$candidate/share/in-1"; then
    printf '%s' "$candidate"
  fi
)

temp-prefix() (
  tmp=${TMPDIR:-/tmp}
  abs-path "${tmp%/}/in-1"
)

resolve-prefix() (
  value=''
  if [[ $placement == temp ]]; then
    temp-prefix
    return
  fi
  value=${PREFIX:-}
  if [[ -z $value ]]; then
    value=$(installed-prefix)
    if [[ $placement == local && $value == "$(temp-prefix)" ]]; then
      value=''
    fi
    if [[ -z $value && $placement == local ]]; then
      if [[ ${EUID:-$(id -u)} == 0 ]]; then value=/usr/local
      else value=$HOME/.local; fi
    fi
    [[ -n $value ]] || value=$(temp-prefix)
  fi
  value=$(abs-path "$value")
  while [[ $value != / && $value == */ ]]; do value=${value%/}; done
  if [[ $value == */bin ]]; then
    value=${value%/bin}
    note "Stripped trailing /bin from PREFIX; using PREFIX=$value"
  fi
  printf '%s' "$value"
)

check-prefix() {
  [[ $prefix == "$(temp-prefix)" ]] || return 0
  if [[ -e $prefix/.git || -d $prefix/in-1 ]] ||
     { [[ -e $prefix/bin/in-1 ]] &&
       ! is-wrapper-under "$prefix/bin/in-1" "$prefix/share/in-1"; }; then
    die "Legacy in-1 layout at '$prefix'; move it aside and retry"
  fi
}

# State storage is independent of the public installation prefix.
set-globals() {
  [[ -n $prefix ]] || prefix=$(resolve-prefix)
  root=$(abs-path "${IN1_ROOT:-$prefix/share/in-1/local}")
  [[ $placement != temp ]] || root=$prefix/share/in-1/local
  makes=$root/makes
  cache=$(tilde-expand "${IN1_CACHE:-$root/cache}")
  # Local installs keep their state outside the executable's git clone.
  in1_root=$self_root
  [[ ! -e $root/.git ]] || in1_root=$root
}

# Clone makes if it is missing.  This is plumbing, not a tool the user
# asked for, so it gets no progress line; the log only shows on
# failure (or everything streams with IN1_VERBOSE=1).
ensure-makes() (
  mkdir -p "$root/log"
  # Allows reset of a state-only root that in-1 actually initialized.
  [[ -e $root/.in-1-state ]] || printf 'in-1 state\n' > "$root/.in-1-state"
  [[ -d $makes ]] && return 0
  log=$root/log/makes.log
  repo=${IN1_MAKES_REPO:-$MAKES_REPO_DEFAULT}
  if [[ ${IN1_VERBOSE-} && -z $quiet ]]; then
    git clone -q "$repo" "$makes" 1>&2 ||
      die "Failed to clone the makes repo"
  elif ! git clone -q "$repo" "$makes" &> "$log"; then
    tail -20 "$log" >&2
    error "Full log: $log"
    die "Failed to clone the makes repo"
  fi
)

# Everything an install needs in place: prereqs, globals, a reset if
# asked (--reset), the makes clone; then update both repositories when
# asked, or check in-1 and automatically update makes when needed.
# Runs before tool args are parsed so an update can bring in a newly
# added tool.
prepare-root() {
  check-prereqs
  set-globals
  [[ $reset ]] && do-reset
  ensure-makes
  if [[ $update ]]; then
    do-update
  else
    check-stale
  fi
}

# Name of the branch origin/HEAD points at (main when unknown)
default-branch() (  # $1=dir
  branch=''
  branch=$(git -C "$1" symbolic-ref -q --short \
    refs/remotes/origin/HEAD 2>/dev/null) || branch=origin/main
  printf '%s' "${branch#origin/}"
)

# Quiet fetch that never prompts and gives up on a stalled connection
git-fetch() (  # $1=dir
  GIT_TERMINAL_PROMPT=0 git -C "$1" \
    -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
    fetch -q --tags origin 2>/dev/null
)

do-update() (
  update-in1
  update-makes
)

update-in1() (
  if [[ ! -e $in1_root/.git ]]; then
    note "'$in1_root' is not a git clone; not updating in-1"
    return 0
  fi
  git-fetch "$in1_root" || die "Failed to fetch in-1 from origin"
  if [[ ${IN1_VERSION-} ]]; then
    git -C "$in1_root" checkout -q "$IN1_VERSION" ||
      die "Failed to checkout '$IN1_VERSION'"
  else
    branch=''
    branch=$(default-branch "$in1_root")
    git -C "$in1_root" checkout -q "$branch" ||
      die "Failed to checkout '$branch'"
    git -C "$in1_root" pull -q || die "Failed to pull latest in-1"
  fi
  success "in-1 is now at version $(get-version "$in1_root")"
)

update-makes() (
  git -C "$makes" pull -q || die "Failed to pull latest makes"
  success "makes is now at $(git -C "$makes" rev-parse --short HEAD)"
)

# Reset managed tools in the selected prefix, preserving in-1 itself.
# Never remove an entire prefix or an unrecognized state directory.
do-reset() (
  dir='' tool='' version='' wrapper='' owned=''
  [[ $root != / && $root != "$HOME" && $root != "$prefix" ]] ||
    die "Unsafe state directory '$root'; not resetting"
  if [[ -d $root ]]; then
    [[ -x $root/bin/in-1 || $root == "$prefix/share/in-1/local" ]] ||
      grep -Fxq 'in-1 state' "$root/.in-1-state" 2>/dev/null ||
      die "'$root' is not an in-1 state directory; not resetting"
  fi
  [[ ! -L $prefix/share && ! -L $prefix/bin ]] ||
    die "Linked bin or share directory under '$prefix'; not resetting"
  # Determine owned version directories before removing their wrappers.
  for tool in "$prefix"/share/*; do
    [[ -d $tool && ! -L $tool && ${tool##*/} != in-1 ]] || continue
    owned=''
    for version in "$tool"/*; do
      [[ -d $version && ! -L $version ]] || continue
      for wrapper in "$prefix"/bin/*; do
        is-wrapper-under "$wrapper" "$version" || continue
        rm -rf "$version" || die "Failed to remove '$version'"
        owned=1
        break
      done
    done
    [[ ! $owned ]] || rmdir "$tool" 2>/dev/null || true
  done
  for wrapper in "$prefix"/bin/*; do
    is-wrapper-under "$wrapper" "$prefix/share" || continue
    is-wrapper-under "$wrapper" "$prefix/share/in-1" && continue
    rm -f "$wrapper" || die "Failed to remove '$wrapper'"
  done
  for dir in makes log cache; do
    [[ -e $root/$dir ]] || continue
    [[ $self_root != "$root/$dir" && $self_root != "$root/$dir/"* ]] || continue
    rm -rf "${root:?}/$dir" || die "Failed to remove '$root/$dir'"
  done
  success "reset: removed managed tools from '$prefix' (kept in-1)" \
    "reset: removed makes/, log/ and cache/ from '$root'"
)

check-stale() {
  [[ ${IN1_OFFLINE-} ]] && return 0
  stale-notice in-1 "$in1_root"
  update-stale-makes
}

# Update makes when its default remote branch is ahead.  A failed fetch
# leaves the existing clone usable, just as the stale notice does.
update-stale-makes() {
  local n
  [[ -e $makes/.git ]] || return 0
  git-fetch "$makes" || return 0
  n=$(git -C "$makes" rev-list --count \
    "HEAD..origin/$(default-branch "$makes")" 2>/dev/null) || return 0
  [[ $n -gt 0 ]] || return 0
  update-makes
}

# One line if the clone in $2 is behind its origin; silent otherwise
# (and when offline)
stale-notice() {  # $1=label $2=dir
  local n
  [[ -e $2/.git ]] || return 0
  git-fetch "$2" || return 0
  n=$(git -C "$2" rev-list --count \
    "HEAD..origin/$(default-branch "$2")" 2>/dev/null) || return 0
  [[ $n -gt 0 ]] || return 0
  note "$1 is $n commit(s) behind; run 'in-1 --update' to update"
}

# Run a command quietly with a progress line:
#   … LABEL installing....
# erased on completion and replaced by a green check or red X result
# line reporting where it installed and how long it took.  All output
# goes to the log file, shown only on failure.  IN1_VERBOSE=1 streams
# everything instead.
progress-run() (  # $1=label $2=logfile $3=disp $4=note; rest=command
  label=$1 log=$2 disp=$3 note=$4 rc=0 pid='' tick=0 start='' end=''
  shift 4
  if [[ ${IN1_VERBOSE-} && -z $quiet ]]; then
    "$@" 1>&2 || rc=$?
    return $rc
  fi
  start=$(now)
  if [[ $quiet ]]; then
    "$@" &> "$log" || rc=$?
    end=$(now)
  elif [[ -t 2 ]]; then
    printf '… %s installing' "$label" >&2
    "$@" &> "$log" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
      sleep 0.1
      tick=$((tick + 1))
      if [[ $((tick % 10)) -eq 0 ]] && kill -0 "$pid" 2>/dev/null
      then
        printf '.' >&2
      fi
    done
    wait "$pid" || rc=$?
    end=$(now)
    printf '\r\033[K' >&2
  else
    printf '… %s installing\n' "$label" >&2
    "$@" &> "$log" || rc=$?
    end=$(now)
  fi
  progress-line "$rc" "$label" "$disp" "$note" \
    "$(elapsed "$start" "$end")"
  if [[ $rc -ne 0 ]]; then
    tail -20 "$log" >&2
    error "Full log: $log"
  fi
  return $rc
)

# Print the result line, colored when stderr is a terminal
progress-line() (  # $1=rc $2=label $3=disp $4=note $5=timing
  rc=$1 label=$2 disp=$3 note=$4 timing=$5
  to='' also='' g='' r='' z=''
  [[ -n $disp ]] && to=" to $disp"
  [[ -n $note ]] && also=" also: $note"
  if [[ -t 2 ]]; then
    g=$'\033[32m'; r=$'\033[31m'; z=$'\033[0m'
  fi
  if [[ $rc -eq 0 ]]; then
    if [[ -z $quiet ]]; then
      printf '%s√%s %s installed%s (%ss)%s\n' \
        "$g" "$z" "$label" "$to" "$timing" "$also" >&2
    fi
  else
    printf '%sX%s %s NOT installed (%ss)\n' \
      "$r" "$z" "$label" "$timing" >&2
  fi
)

list-tools() (
  set-globals
  [[ $reset ]] && do-reset
  ensure-makes
  [[ $update ]] && do-update
  file='' name='' filter=''
  filter=" $(printf '%s' "$tool_filter" | tr '\n' ' ') "
  # Tools from makes and the aliases from share/tools.mk, as one
  # sorted list (an alias may share its name with a makes tool)
  {
    for file in "$makes"/*.mk; do
      name=${file##*/}
      name=${name%.mk}
      case $filter in *" $name "*) continue;; esac
      printf '%s\n' "$name"
    done
    while read -r name tool; do
      [[ -f $makes/$name.mk ]] && continue
      printf '%s (%s)\n' "$name" "$tool"
    done < <(alias-pairs)
  } | sort -u
)

# Parse args into req_name / req_tool (bare tool or alias names) and
# make_args (any NAME=VALUE argument, passed through to make).  A pin
# is just the tool's make variable, e.g. `perl PERL-VERSION=5.42.0`.
parse-tool-args() {
  req_name=(); req_tool=(); make_args=()
  local arg name tool
  [[ $# -gt 0 ]] || die "No tools specified. Try: in-1 --help"
  for arg; do
    if [[ $arg == *=* ]]; then
      name=${arg%%=*}
      [[ $name =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] ||
        die "Invalid make variable '$name' in '$arg'"
      case $name in
        MAKES-LOCAL-DIR|MAKES_LOCAL_DIR|MAKES_CACHE_DIR)
          die "'$name' is reserved and can not be set";;
        PREFIX)  # the install prefix, same as the env var
          PREFIX=${arg#*=}
          continue;;
      esac
      make_args+=("$arg")
      continue
    fi
    name=$arg
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9.+_-]*$ ]] ||
      die "Invalid tool name '$name'"
    if [[ -f $makes/$name.mk ]]; then
      tool=$name
    else
      tool=$(alias-tool "$name")
      [[ -n $tool ]] ||
        die "Unknown tool '$name'." \
          "Run \`in-1 --list\` to see available tools."
      [[ -f $makes/$tool.mk ]] ||
        die "Alias '$name' maps to unknown tool '$tool'"
    fi
    req_name+=("$name")
    req_tool+=("$tool")
  done
  [[ ${#req_name[@]} -gt 0 ]] || {
    [[ ${#make_args[@]} -gt 0 ]] &&
      die "No tool named. A NAME=VALUE arg sets a make variable;" \
        "add a tool too, e.g. 'perl PERL-VERSION=5.42.0'."
    die "No tools specified. Try: in-1 --help"
  }
}

# The primary command shown/versioned for a requested name
primary-of() (  # $1=name
  p='' rest=''
  read -r p rest <<< "$(meta "$1-bin")"
  [[ -n $p ]] || p=$1
  printf '%s' "$p"
)

gen-makefile() (  # $1=install-dir $2=makefile-path $3=tool
  mkdir -p "${2%/*}"
  {
    # override so a NAME=VALUE make arg can not redirect the install
    printf 'override MAKES-LOCAL-DIR := %s\n' "$1"
    printf 'IN1-SHARE := %s/share\n' "$self_root"
    printf 'include %s/init.mk\n' "$makes"
    if [[ $3 == in-1 ]]; then
      printf 'IN-1-VERSION ?= main\n'
      # shellcheck disable=SC2016  # make syntax, expanded by make
      printf 'IN-1-REF ?= $(IN-1-VERSION)\n'
    fi
    printf 'include %s/%s.mk\n' "$makes" "$3"
    # in-1's own per-tool additions (exported vars land in wrappers)
    if [[ -f $self_root/share/$3.mk ]]; then
      # shellcheck disable=SC2016  # make syntax, expanded by make
      printf 'include $(IN1-SHARE)/%s.mk\n' "$3"
    fi
    printf 'include %s/shell.mk\n' "$makes"
    # shellcheck disable=SC2016  # make syntax, expanded by make
    printf 'in1-ver:\n\t@echo $(or $($(PRIMARY)-VERSION),$(%s-VERSION))\n' \
      "$(uc "$3")"
  } > "$2"
)

# Resolve the version to install: the primary command's makes version
# variable (<PRIMARY>-VERSION), falling back to the tool's
# (<TOOL>-VERSION), after any NAME=VALUE make args are applied.  This
# handles tools whose file name differs from their command, like
# fortran.mk providing fpm (FPM-VERSION).
tool-version() (  # $1=tool $2=primary
  qf=$root/log/$1.ver.mk
  gen-makefile "$root/log/.meta" "$qf" "$1"
  make -s -C "$root" -f "$qf" ${make_args[@]+"${make_args[@]}"} \
    in1-ver PRIMARY="$(uc "$2")" 2>/dev/null || true
)

setup-make-env() {
  # Own the environment make runs in: a parent make (or a makes-based
  # Makefile) may have exported vars that would redirect the install.
  # MAKES_LOCAL_DIR must be unset so each makefile's own
  # MAKES-LOCAL-DIR (one per tool+version) takes effect.
  unset MAKEFLAGS MFLAGS MAKELEVEL GNUMAKEFLAGS MAKEOVERRIDES \
    MAKES_TEE MAKES_SCRIPT MAKES_REPO_DIR MAKES_LOCAL_DIR \
    2>/dev/null || true
  export MAKES_CACHE_DIR=$cache
  mkdir -p "$cache"
}

capture-env() {  # $1=makefile-path $2=out-file
  # deps are up to date now; dump the recipe environment
  env_sep='nl'
  if env -0 >/dev/null 2>&1; then
    env_sep=nul
    make -s -C "$root" -f "$1" ${make_args[@]+"${make_args[@]}"} \
      shell CMD='exec env -0' > "$2" ||
      die "Environment capture failed"
  else
    make -s -C "$root" -f "$1" ${make_args[@]+"${make_args[@]}"} \
      shell CMD='exec env' > "$2" ||
      die "Environment capture failed"
  fi
}

load-env() {  # $1=env-file; fills env_names/env_values
  env_names=() env_values=()
  local entry
  if [[ $env_sep == nul ]]; then
    while IFS= read -r -d '' entry; do
      add-env-entry "$entry"
    done < "$1"
  else
    while IFS= read -r entry; do
      add-env-entry "$entry"
    done < "$1"
  fi
}

add-env-entry() {
  local name=${1%%=*}
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 0
  env_names+=("$name")
  env_values+=("${1#*=}")
}

# Remove every occurrence of entry $2 from colon list $1
strip-entry() (
  rest=$1 out='' dir=''
  while [[ -n $rest ]]; do
    dir=${rest%%:*}
    if [[ $rest == *:* ]]; then rest=${rest#*:}; else rest=''; fi
    [[ $dir == "$2" ]] && continue
    out=$out$dir:
  done
  printf '%s' "${out%:}"
)

# Prepend entries of colon list $1 not already in colon list $2
path-merge() (
  out=$2 i='' dir=''
  parts=()
  IFS=: read -ra parts <<< "$1"
  for ((i=${#parts[@]}-1; i>=0; i--)); do
    dir=${parts[i]}
    [[ -n $dir ]] || continue
    case ":$out:" in *":$dir:"*) continue;; esac
    out=$dir:$out
  done
  printf '%s' "$out"
)

# Diff env_names/env_values (a tool's install env) against our own.
# Fills out_names/out_values (tool vars) and added_dirs (the tool's
# new PATH dirs).  $makes/util is stripped.
compute-exports() {
  out_names=() out_values=() added_dirs=()
  local i name value cur denied new_path=''
  denied=" $(printf '%s' "$env_denylist" | tr '\n' ' ') "
  for ((i=0; i<${#env_names[@]}; i++)); do
    name=${env_names[i]}
    value=${env_values[i]}
    case $denied in *" $name "*) continue;; esac
    if [[ $name == PATH ]]; then
      new_path=$value
      continue
    fi
    if [[ ${!name+x} ]]; then cur=${!name}; else cur=$'\1unset\1'; fi
    [[ $value == "$cur" ]] && continue
    if [[ -n $cur && $cur != $'\1unset\1' && $value == *":$cur" ]]
    then
      value=$(path-merge "${value%":$cur"}" "$cur")
      [[ $value == "$cur" ]] && continue
    fi
    out_names+=("$name")
    out_values+=("$value")
  done

  [[ -n $new_path ]] || return 0
  new_path=$(strip-entry "$new_path" "$makes/util")
  local rest dir
  rest=$new_path
  while [[ -n $rest ]]; do
    dir=${rest%%:*}
    if [[ $rest == *:* ]]; then rest=${rest#*:}; else rest=''; fi
    [[ -n $dir ]] || continue
    case ":$PATH:" in *":$dir:"*) continue;; esac
    case " ${added_dirs[*]-} " in *" $dir "*) continue;; esac
    added_dirs+=("$dir")
  done
}

# Append this tool's man dirs (siblings of its bin dirs) to man_adds
collect-manpath() {
  local dir man
  for dir in ${added_dirs[@]+"${added_dirs[@]}"}; do
    for man in "${dir%/*}/share/man" "${dir%/*}/man"; do
      [[ -d $man ]] || continue
      case ":$man_adds:" in *":$man:"*) continue;; esac
      man_adds=$man_adds${man_adds:+:}$man
    done
  done
}

# Single-quote $1 for bash/zsh eval
sq() (
  s=${1//\'/\'\\\'\'}
  printf "'%s'" "$s"
)

# Single-quote $1 for fish eval
fq() (
  s=${1//\\/\\\\}
  s=${s//\'/\\\'}
  printf "'%s'" "$s"
)

# Write one env-baking wrapper (live PATH prepend).  Uses the current
# out_names/out_values for the tool's env vars.  $4, if given, is a
# bash snippet run before the exec; $cmd holds the real command.
write-one-wrapper() {  # $1=real-cmd $2=wrapper-path $3=path-prefix
  local i
  if [[ -e $2 ]] &&
     ! grep -q '^# in-1 wrapper$' "$2" 2>/dev/null; then
    note "Skipping existing non-wrapper file '$2'"
    return 0
  fi
  {
    printf '#!/usr/bin/env bash\n'
    printf '# in-1 wrapper\n'
    for ((i=0; i<${#out_names[@]}; i++)); do
      case ${out_names[i]} in PATH|MANPATH) continue;; esac
      printf 'export %s=%q\n' "${out_names[i]}" "${out_values[i]}"
    done
    # shellcheck disable=SC2016  # $PATH expands when the wrapper runs
    printf 'export PATH=%q${PATH:+:$PATH}\n' "$3"
    printf 'cmd=%q\n' "$1"
    [[ -n ${4-} ]] && cat "$4"
    # shellcheck disable=SC2016  # $cmd expands when the wrapper runs
    printf 'exec "$cmd" "$@"\n'
  } > "$2"
  chmod +x "$2"
  wrap_count=$((wrap_count + 1))
}

# Write wrappers into $install_root/bin for every command a tool
# installed; the primary command also gets a <primary>-<version> one.
# The primary's wrappers include share/<tool>.wrap when it exists.
write-wrappers() {  # $1=version $2=primary $3=tool
  local pfx dir f cmd primary_real='' snip=''
  pfx=$(join-colon ${added_dirs[@]+"${added_dirs[@]}"})
  [[ -f $self_root/share/$3.wrap ]] && snip=$self_root/share/$3.wrap
  for dir in ${added_dirs[@]+"${added_dirs[@]}"}; do
    for f in "$dir"/*; do
      [[ -f $f && -x $f ]] || continue
      cmd=${f##*/}
      [[ $cmd == .* ]] && continue
      if [[ $cmd == "$2" ]]; then
        primary_real=$f
        write-one-wrapper "$f" "$install_root/bin/$cmd" "$pfx" "$snip"
      else
        write-one-wrapper "$f" "$install_root/bin/$cmd" "$pfx"
      fi
    done
  done
  if [[ -n $primary_real ]]; then
    write-one-wrapper "$primary_real" \
      "$install_root/bin/$2-$1" "$pfx" "$snip"
  fi
}

# Install every requested tool into its own share/<tool>/<version>
# tree and write command wrappers into $install_root/bin.
install-all() {  # $1=install-root
  install_root=$1
  setup-make-env
  mkdir -p "$root/log" "$install_root/bin"
  man_adds=''
  comp_dirs=()
  wrap_count=0
  local i name tool version idir mf primary disp note
  local envfile=$root/log/in-1-env.$$
  for ((i=0; i<${#req_name[@]}; i++)); do
    name=${req_name[i]}
    tool=${req_tool[i]}
    primary=$(primary-of "$name")
    version=$(tool-version "$tool" "$primary")
    [[ -n $version ]] || version=current
    idir=$install_root/share/$tool/$version
    mf=$root/log/$tool.mk
    gen-makefile "$idir" "$mf" "$tool"
    disp=$install_root/bin/$primary
    note=$(meta "$name-also")
    progress-run "$primary v$version" "$root/log/$tool.log" \
      "$disp" "$note" \
      make --no-print-directory -C "$root" -f "$mf" \
      ${make_args[@]+"${make_args[@]}"} shell CMD=: ||
      exit 1
    capture-env "$mf" "$envfile"
    load-env "$envfile"
    rm -f "$envfile"
    compute-exports
    write-wrappers "$version" "$primary" "$tool"
    collect-manpath
    comp_dirs+=("$idir")
  done
}

# --- shell emit (session mode) ---------------------------------------

emit-prepend-sh() (  # $1=var $2=dir
  # shellcheck disable=SC2016  # $var expands in the emitted user shell
  printf 'case ":${%s-}:" in *":%s:"*) ;; *) export %s=%s${%s:+:$%s};; esac\n' \
    "$1" "$2" "$1" "$(sq "$2")" "$1" "$1"
)

emit-manpath-sh() (
  [[ -n $man_adds ]] || return 0
  first=${man_adds%%:*}
  # shellcheck disable=SC2016  # $MANPATH expands in the emitted shell
  printf 'case ":${MANPATH-}:" in *":%s:"*) ;; *) if [ -n "${MANPATH-}" ]; then export MANPATH=%s:$MANPATH; else export MANPATH=%s:; fi;; esac\n' \
    "$first" "$(sq "$man_adds")" "$(sq "$man_adds")"
)

emit-session-sh() (  # $1=bash|zsh
  printf 'export PATH=%s\n' \
    "$(sq "$install_root/bin:$(strip-entry "$PATH" "$install_root/bin")")"
  emit-manpath-sh
  emit-completions "$1"
  emit-extras "$1"
  emit-tools-var sh
  printf 'hash -r 2>/dev/null || true\n'
)

emit-session-fish() (
  bindir=$install_root/bin dir=''
  # shellcheck disable=SC2016  # $PATH expands in the user's fish
  printf 'set -l _in1_path; for _in1_dir in $PATH; if test "$_in1_dir" != %s; set -a _in1_path "$_in1_dir"; end; end; set -gx PATH %s $_in1_path; set -e _in1_path; set -e _in1_dir\n' \
    "$(fq "$bindir")" "$(fq "$bindir")"
  if [[ -n $man_adds ]]; then
    printf 'set -q MANPATH; or set -gx MANPATH ""\n'
    rest=$man_adds
    while [[ -n $rest ]]; do
      dir=${rest%%:*}
      if [[ $rest == *:* ]]; then rest=${rest#*:}; else rest=''; fi
      # shellcheck disable=SC2016  # $MANPATH expands in the user's fish
      printf 'contains -- %s $MANPATH; or set -gx MANPATH %s $MANPATH\n' \
        "$(fq "$dir")" "$(fq "$dir")"
    done
  fi
  emit-completions fish
  emit-extras fish
  emit-tools-var fish
)

emit-tools-var() (  # $1=sh|fish
  list=${IN1_TOOLS-} n=''
  # After a reset only the tools just installed are active
  [[ $reset ]] && list=''
  for n in ${req_name[@]+"${req_name[@]}"}; do
    case " $list " in *" $n "*) continue;; esac
    list=$list${list:+ }$n
  done
  if [[ $1 == fish ]]; then
    printf 'set -gx IN1_TOOLS %s\n' "$(fq "$list")"
  else
    printf 'export IN1_TOOLS=%s\n' "$(sq "$list")"
  fi
)

# Source share/<name>.<ext> extras for the target shell, if present.
# Each runs with IN1_ROOT and IN1_TOOL_DIR (that tool's install dir,
# comp_dirs[i] pairs with req_name[i]) exported.
emit-extras() (  # $1=bash|zsh|fish
  exts='' i='' n='' ext='' file=''
  case $1 in
    bash) exts='sh bash';;
    zsh) exts='sh zsh';;
    fish) exts='fish';;
  esac
  for ((i=0; i<${#req_name[@]}; i++)); do
    n=${req_name[i]}
    for ext in $exts; do
      file=$self_root/share/$n.$ext
      [[ -f $file ]] || continue
      if [[ $1 == fish ]]; then
        printf 'set -gx IN1_ROOT %s\n' "$(fq "$root")"
        printf 'set -gx IN1_TOOL_DIR %s\n' "$(fq "${comp_dirs[i]}")"
        printf 'source %s\n' "$(fq "$file")"
      else
        printf 'export IN1_ROOT=%s\n' "$(sq "$root")"
        printf 'export IN1_TOOL_DIR=%s\n' "$(sq "${comp_dirs[i]}")"
        printf 'source %s\n' "$(sq "$file")"
      fi
    done
  done
)

# Best-effort completion setup from each installed tool tree
emit-completions() (  # $1=bash|zsh|fish
  d='' dir='' file=''
  for d in ${comp_dirs[@]+"${comp_dirs[@]}"}; do
    case $1 in
      bash)
        for dir in "$d/share/bash-completion/completions" \
                   "$d/etc/bash_completion.d"; do
          [[ -d $dir ]] || continue
          for file in "$dir"/*; do
            [[ -f $file ]] || continue
            printf 'source %s 2>/dev/null || true\n' "$(sq "$file")"
          done
        done
        ;;
      zsh)
        dir=$d/share/zsh/site-functions
        # shellcheck disable=SC2016  # $fpath expands in the user's zsh
        [[ -d $dir ]] &&
          printf 'fpath=(%s $fpath)\n' "$(sq "$dir")"
        ;;
      fish)
        dir=$d/share/fish/vendor_completions.d
        # shellcheck disable=SC2016  # expands in the user's fish
        [[ -d $dir ]] &&
          printf 'set -g fish_complete_path %s $fish_complete_path\n' \
            "$(fq "$dir")"
        ;;
    esac
  done
  return 0
)

# --- modes -----------------------------------------------------------

session-prepare() {  # sets install_root, installs, writes wrappers
  prepare-root
  parse-tool-args "$@"
  install-all "$prefix"
}

check-shell() (  # $1=shell -> bash|zsh|fish
  case $1 in
    bash|zsh|fish) printf '%s' "$1";;
    sh) printf bash;;
    *) die "Unsupported shell '$1' (want bash, zsh or fish)";;
  esac
)

do-env() (
  shell=''
  shell=$(check-shell "$1"); shift
  session-prepare "$@"
  [[ $placement != local ]] || local-in1-hint "$prefix" "$shell"
  if [[ $shell == fish ]]; then
    emit-session-fish
  else
    emit-session-sh "$shell"
  fi
)

do-run() (
  if [[ $# -eq 0 ]]; then
    prepare-root
    die "No tools specified. Try: in-1 --help"
  fi
  note "Run 'source <(in-1 --rc)' or add it to ~/.bashrc"
  session-prepare "$@"
)

# The clone an installed in-1 lives in, given its share/in-1/<v> dir
in1-clone-of() (  # $1=install-dir
  d=''
  for d in "$1"/cache/in-1-*; do
    [[ -x $d/bin/in-1 ]] || continue
    printf '%s' "$d"
    return 0
  done
  return 1
)

# The clone of the in-1 just installed with --local, if any
local-in1-clone() (
  i=''
  for ((i=0; i<${#req_name[@]}; i++)); do
    [[ ${req_name[i]} == in-1 ]] || continue
    in1-clone-of "${comp_dirs[i]}" && return 0
  done
  return 1
)

# After `--local in-1`, say how to get the shell side of it.  The
# rc line goes through the installed command, so it survives version
# changes; so does that in-1's root, PREFIX/share/in-1/local.
local-in1-hint() (  # $1=prefix $2=shell ('' unless via --env)
  cmd=in-1
  [[ $quiet ]] && return 0
  local-in1-clone >/dev/null || return 0
  case ":$PATH:" in
    *":$1/bin:"*) ;;
    *) cmd=$1/bin/in-1;;
  esac
  if [[ -n $2 ]]; then
    shell_name='' rc_file='' rc_line=''
    case $2 in
      bash)
        shell_name=Bash
        rc_file=\~/.bashrc
        rc_line="source <($cmd --rc)"
        ;;
      zsh)
        shell_name=Zsh
        rc_file=\~/.zshrc
        rc_line="source <($cmd --rc)"
        ;;
      fish)
        shell_name=Fish
        rc_file=\~/.config/fish/config.fish
        rc_line="$cmd --rc | source"
        ;;
    esac
    note "For the in-1 shell function, man page and tab completion in"
    printf '%s\n\n  %s\n' \
      "every new $shell_name shell, add this line to $rc_file:" \
      "$rc_line" >&2
    return 0
  fi
  note "For the in-1 shell function, man page and tab completion in"
  printf '%s\n\n  %s\n  %s\n' \
    "every new shell, add the appropriate line to its rc file:" \
    "source <($cmd --rc)     # bash / zsh" \
    "$cmd --rc | source      # fish" >&2
)

# --local through --env (the one-liner) hands the caller's shell
# shell code: forget stale command paths, and for a just installed
# in-1 the same line 'in-1 --rc' prints, so the shell function, man
# page and completion are there right away.
emit-local() (  # $1=bash|zsh|fish
  if [[ $1 == fish ]]; then
    emit-session-fish
  else
    emit-session-sh "$1"
  fi
)

do-local() (  # $1=shell ('' unless via --env); rest=tool args
  shell=$1; shift
  [[ -z $shell ]] || shell=$(check-shell "$shell")
  prepare-root
  parse-tool-args "$@"

  install-all "$prefix"

  if [[ ${#req_name[@]} -ne 1 || ${req_name[0]} != in-1 ]]; then
    success "Installed ${req_name[*]}:" \
      "$wrap_count command wrappers in '$prefix/bin'"
    case ":$PATH:" in
      *":$prefix/bin:"*) ;;
      *) note "'$prefix/bin' is not in your PATH";;
    esac
  fi
  local-in1-hint "$prefix" "$shell"
  [[ -z $shell ]] || emit-local "$shell"
)

# Args for --uninstall: tool names (an alias resolves through
# share/tools.mk, so no makes clone is needed) and PREFIX=DIR
parse-uninstall-args() {
  req_name=(); req_tool=()
  local arg name tool
  for arg; do
    if [[ $arg == PREFIX=* ]]; then
      PREFIX=${arg#*=}
      continue
    fi
    [[ $arg == *=* ]] &&
      die "--uninstall takes no make variables ('$arg')"
    name=$arg
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9.+_-]*$ ]] ||
      die "Invalid tool name '$name'"
    tool=$(alias-tool "$name")
    req_name+=("$name")
    req_tool+=("${tool:-$name}")
  done
  [[ ${#req_name[@]} -gt 0 ]] ||
    die "No tools specified. Try: in-1 --help"
}

# True when $1 is an in-1 wrapper whose command lives under dir $2
is-wrapper-under() (  # $1=file $2=dir
  line='' n=0 under=''
  [[ -f $1 ]] || return 1
  head -c 19 "$1" 2>/dev/null |
    grep -Fqx '#!/usr/bin/env bash' || return 1
  under="cmd=$(printf '%q' "$2/")"
  while IFS= read -r line; do
    n=$((n + 1))
    [[ $n -eq 2 && $line != '# in-1 wrapper' ]] && return 1
    [[ $n -gt 2 && $line == "$under"* ]] && return 0
  done < "$1"
  return 1
)

validate-pattern() (  # $1=option $2=pattern
  status=0
  grep -E -- "$2" </dev/null >/dev/null 2>&1 || status=$?
  [[ $status -le 1 ]] || die "Invalid $1 pattern '$2'"
)

filter-rows() {  # $1=pattern; no matches are a successful empty listing
  grep -E -- "$1" || [[ $? -eq 1 ]]
}

# List wrapper-backed version directories without preparing a root.
do-show() (
  local pattern='' have_pattern='' arg dir tool w
  for arg; do
    if [[ $arg == PREFIX=* ]]; then
      PREFIX=${arg#*=}
    elif [[ -z $have_pattern ]]; then
      pattern=$arg
      have_pattern=1
    else
      die "--show takes at most one pattern"
    fi
  done
  # Validate even when there are no installations to filter.
  validate-pattern --show "$pattern" || return $?
  {
    for dir in "$prefix"/share/*/*; do
      [[ -d $dir ]] || continue
      for w in "$prefix"/bin/*; do
        is-wrapper-under "$w" "$dir" || continue
        tool=${dir%/*}
        printf '%s\t%s\t%s\n' "${tool##*/}" "${dir##*/}" "$dir"
        break
      done
    done
  } | LC_ALL=C sort -u | filter-rows "$pattern"
)

# Undo --local installs: remove PREFIX/share/<tool>/ (every version)
# and each in-1 wrapper in PREFIX/bin whose command lives under it.
# Needs neither a root nor makes.
do-uninstall() (
  parse-uninstall-args "$@"
  name='' tool='' sdir='' w='' n='' i='' missing=''
  for ((i=0; i<${#req_name[@]}; i++)); do
    name=${req_name[i]}; tool=${req_tool[i]}
    # Install parsing prefers a direct Makes tool over a same-named alias.
    # Its install dir preserves that choice without needing the Makes clone.
    [[ -e $prefix/share/$name ]] && tool=$name
    sdir=$prefix/share/$tool
    n=0
    for w in "$prefix"/bin/*; do
      is-wrapper-under "$w" "$sdir" || continue
      rm -f "$w" || die "Failed to remove '$w'"
      n=$((n + 1))
    done
    if [[ -e $sdir ]]; then
      rm -rf "${prefix:?}/share/${tool:?}" ||
        die "Failed to remove '$sdir'"
    elif [[ $n -eq 0 ]]; then
      error "'$name' is not installed under '$prefix'"
      missing=1
      continue
    fi
    success "Uninstalled $name:" \
      "removed $n command wrappers from '$prefix/bin' and '$sdir'"
  done
  [[ -z $missing ]]
)

do-complete() (
  case $1 in
    bash)
      cat <<'...'
_in_1_complete() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local opts='--env --local --temp --list --show --complete --rc --uninstall
    -q --quiet --update --reset --version --help'
  local entry name word
  local -a labels=()
  COMPREPLY=()
  for word in $opts; do
    [[ $word == "$cur"* ]] || continue
    COMPREPLY+=("$word")
    labels+=("$word")
  done
  while IFS= read -r entry; do
    name=${entry%% *}
    [[ $name == "$cur"* ]] || continue
    COMPREPLY+=("$name")
    labels+=("$entry")
  done < <(command in-1 --list 2>/dev/null)
  # Readline has no separate display labels. Print them only for a
  # listing request; insertion and menu completion use the bare names.
  if [[ ${COMP_TYPE:-0} -eq 63 && ${#COMPREPLY[@]} -gt 1 ]]; then
    printf '\n' >&2
    printf '  %s\n' "${labels[@]}" >&2
    COMPREPLY=()
  fi
}
complete -F _in_1_complete in-1
...
      ;;
    zsh)
      cat <<'...'
_in_1_complete() {
  local -a opts names labels
  local entry name
  opts=(--env --local --temp --list --show --complete --rc --uninstall
    -q --quiet --update --reset --version --help)
  for name in "${opts[@]}"; do
    [[ $name == "$PREFIX"* ]] || continue
    names+=("$name")
    labels+=("$name")
  done
  for entry in "${(@f)$(command in-1 --list 2>/dev/null)}"; do
    name=${entry%% *}
    [[ -n $name && $name == "$PREFIX"* ]] || continue
    names+=("$name")
    labels+=("$entry")
  done
  if (( ${#names} > 1 )); then
    compadd -d labels -a names
  else
    compadd -a names
  fi
}
if (( $+functions[compdef] )); then
  compdef _in_1_complete in-1
fi
...
      ;;
    fish)
      cat <<'...'
function _in_1_candidates
  set -l cur (commandline -ct)
  set -l names
  set -l labels
  for entry in (command in-1 --list 2>/dev/null)
    set -l parts (string split -m 1 ' ' -- "$entry")
    set -l name $parts[1]
    string match -q -- "$cur*" "$name"; or continue
    set -a names "$name"
    set -a labels "$entry"
  end
  for i in (seq (count $names))
    if test (count $names) -gt 1; and string match -q '* (*)' "$labels[$i]"
      set -l tool (string replace -r '^.*\(([^)]+)\)$' '$1' "$labels[$i]")
      printf '%s\t%s\n' "$names[$i]" "$tool"
    else
      printf '%s\n' "$names[$i]"
    end
  end
end
complete -c in-1 -f
complete -c in-1 -a '(_in_1_candidates)'
complete -c in-1 -l env -d 'Print env setup code for a shell'
complete -c in-1 -l local -d 'Install tools under PREFIX'
complete -c in-1 -l temp -d 'Use the temporary in-1 prefix'
complete -c in-1 -l uninstall -d 'Remove tools from their install prefix'
complete -c in-1 -l list -d 'List available tools'
complete -c in-1 -l show -d 'Show installed tool versions and locations'
complete -c in-1 -l complete -d 'Print command completion for a shell'
complete -c in-1 -l rc -d 'Print the shell setup line (source it)'
complete -c in-1 -s q -l quiet -d 'Suppress output on success'
complete -c in-1 -l update -d 'Update in-1 and makes first'
complete -c in-1 -l reset -d 'Remove managed tools and state, keeping in-1'
complete -c in-1 -l version -d 'Print the in-1 version'
complete -c in-1 -l help -d 'Show help'
...
      ;;
    *) die "Unsupported shell '$1' (want bash, zsh or fish)";;
  esac
)

main "$@"
