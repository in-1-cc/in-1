#!/usr/bin/env bash

# in-1 - install dev tools for the current shell session
#
# https://in-1.cc/
# https://github.com/in-1-cc/in-1
#
# Uses https://github.com/makeplus/makes to install each tool.

set -euo pipefail

IN1_FALLBACK_VERSION=0.1.0
MAKES_REPO_DEFAULT=https://github.com/makeplus/makes

# Vars that make sets for its own use, or that must never leak into an
# interactive shell (local.mk exports TMPDIR, init.mk exports LANG):
env_denylist='MAKEFLAGS MFLAGS MAKELEVEL MAKE_TERMOUT MAKE_TERMERR
GNUMAKEFLAGS MAKEOVERRIDES MAKES_QUIET MAKES_CACHE_DIR MAKES_LOCAL_DIR
CMD SHLVL PWD OLDPWD _ SHELL SHELLOPTS BASHOPTS TMPDIR LANG LC_ALL
HOME TERM PS1 COLUMNS LINES'

tool_filter='agents clean claude docker docker-or-podman git help init
local podman shell'

self_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)

# Set by -U/--update (or IN1_UPDATE); update in-1 and makes first
update=''

main() {
  local mode=run shell='' arg
  local -a tools=()

  [[ ${IN1_UPDATE-} ]] && update=1

  while [[ $# -gt 0 ]]; do
    arg=$1; shift
    case $arg in
      --env)
        mode='env'
        [[ $# -gt 0 ]] || die "--env requires a shell name"
        shell=$1; shift
        ;;
      --local) mode=local;;
      --list) list-tools | run-pager || true; return 0;;
      --complete)
        [[ $# -gt 0 ]] || die "--complete requires a shell name"
        do-complete "$1"; return 0
        ;;
      -U|--update) update=1;;
      --version) printf 'in-1 %s\n' "$(get-version)"; return 0;;
      --help|-h) usage | run-pager || true; return 0;;
      -*) die "Unknown option '$arg'. Try: in-1 --help";;
      *) tools+=("$arg");;
    esac
  done

  # A bare update (no tools) just refreshes in-1 and makes
  if [[ $update && ${#tools[@]} -eq 0 ]]; then
    prepare-root
    return 0
  fi

  case $mode in
    env) do-env "$shell" ${tools[@]+"${tools[@]}"};;
    local) do-local ${tools[@]+"${tools[@]}"};;
    run) do-run ${tools[@]+"${tools[@]}"};;
  esac
}

usage() {
  cat <<'...'
in-1 - instant dev tools for your current shell

Usage:
  source <(curl -sL in-1.cc) TOOL... [VAR=VALUE]...   # bash / zsh
  curl -sL in-1.cc | source - TOOL... [VAR=VALUE]...  # fish

  in-1 TOOL... [VAR=VALUE]... Install tools for this shell session
  in-1 --local TOOL...        Install tools under PREFIX for keeps
  in-1 --list               List available tools and aliases
  in-1 --env SHELL TOOL...  Print env setup code for SHELL
                            (bash, zsh or fish)
  in-1 --complete SHELL     Print in-1 command completion for SHELL
  in-1 -U, --update [ARGS]  Update in-1 and makes, then continue
  in-1 --version            Print the in-1 version
  in-1 --help               Show this help

Each install goes under <prefix>/share/<tool>/<version> and gets a
command wrapper in <prefix>/bin, which is the single dir put on PATH.
So `which <cmd>` is always <prefix>/bin/<cmd>.  The primary command
of a tool also gets a version-specific wrapper, <cmd>-<version>.

A NAME=VALUE argument is passed through to makes as a variable, so
pin a version with its makes variable, e.g.
'in-1 perl PERL-VERSION=5.42.0'.

An install checks whether in-1 or makes is behind its origin and
says so; nothing updates unless you pass -U.

Environment variables:
  IN1_ROOT        The in-1 clone; holds makes/, local/, log/ and
                  cache/.  Default: the dir this command runs from
                  ('/tmp/in-1' for the one-liner)
  IN1_CACHE       Download cache dir; default '$IN1_ROOT/cache'
  PREFIX          Install prefix; session default '$IN1_ROOT/local',
                  --local default '~/.local' ('/usr/local' as root)
  IN1_REPO        in-1 repo URL to clone
  IN1_MAKES_REPO  makes repo URL to clone
  IN1_VERSION     in-1 version (git ref) to use
  IN1_UPDATE      Set to 1 for the same effect as -U
  IN1_OFFLINE     Set to 1 to skip the is-it-behind check
  IN1_VERBOSE     Set to 1 to stream full install output instead of
                  the quiet progress lines

See 'man in-1' or https://in-1.cc/doc/ for full documentation.
...
}

die() { printf 'in-1: %s\n' "$@" >&2; exit 1; }
warn() { printf 'in-1: %s\n' "$@" >&2; }

# Page stdin when writing to a terminal.  Honor PAGER; use
# 'less -FRX' when PAGER is unset or exactly 'less'.
run-pager() {
  if [[ ! -t 1 ]]; then
    cat
    return
  fi
  local pager=${PAGER-}
  if [[ -z $pager || $pager == less ]]; then
    if command -v less >/dev/null 2>&1; then
      less -FRX
    else
      cat
    fi
  else
    # shellcheck disable=SC2086  # PAGER may carry its own arguments
    $pager
  fi
}

get-version() {
  set-globals
  # Guarded: a non-clone root inside another repo must not describe it
  if [[ -e $root/.git ]]; then
    git -C "$root" describe --tags --always 2>/dev/null && return 0
  fi
  printf '%s\n' "$IN1_FALLBACK_VERSION"
}

uc() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

join-colon() { local IFS=:; printf '%s' "$*"; }

tilde-expand() {
  # shellcheck disable=SC2088  # literal leading tilde is the point
  case $1 in
    '~') printf '%s' "$HOME";;
    '~/'*) printf '%s/%s' "$HOME" "${1#'~/'}";;
    *) printf '%s' "$1";;
  esac
}

# Absolute path, tilde-expanded, with relative paths anchored to the
# caller's current directory (not the internal makes root)
abs-path() {
  local p
  p=$(tilde-expand "$1")
  case $p in
    /*) printf '%s' "$p";;
    *) printf '%s/%s' "$PWD" "$p";;
  esac
}

# Current time in seconds with a fractional part when available
now() {
  if [[ -n ${EPOCHREALTIME:-} ]]; then
    printf '%s' "${EPOCHREALTIME/,/.}"
  else
    date +%s.%N 2>/dev/null || date +%s
  fi
}

# Elapsed seconds between two now() readings, as N.NN
elapsed() {  # $1=start $2=end
  awk -v a="$1" -v b="$2" 'BEGIN { d = b - a; if (d < 0) d = 0
    printf "%.2f", d }'
}

# Look up a variable from share/tools.mk (flat "key := value" lines).
# Values are literal; make is not involved so '*' etc. do not expand.
meta() {  # $1=key -> value ('' if unset)
  local f=$self_root/share/tools.mk line key=$1 v
  [[ -f $f ]] || return 0
  while IFS= read -r line; do
    line=${line%%#*}
    case $line in
      "$key"[[:space:]]*:=*|"$key":=*) ;;
      *) continue;;
    esac
    v=${line#*:=}
    v=${v#"${v%%[![:space:]]*}"}
    v=${v%"${v##*[![:space:]]}"}
    printf '%s' "$v"
    return 0
  done < "$f"
}

# Alias names declared in share/tools.mk via "<name>-isa := <tool>"
list-aliases() {
  local f=$self_root/share/tools.mk line k
  [[ -f $f ]] || return 0
  while IFS= read -r line; do
    line=${line%%#*}
    case $line in
      *-isa[[:space:]]*:=*|*-isa:=*) ;;
      *) continue;;
    esac
    k=${line%%:=*}
    k=${k//[[:space:]]/}
    printf '%s\n' "${k%-isa}"
  done < "$f"
}

check-prereqs() {
  local cmd
  for cmd in git curl make; do
    command -v "$cmd" >/dev/null 2>&1 ||
      die "'$cmd' is required but not found in PATH"
  done
  case $(make --version 2>/dev/null) in
    *GNU\ Make*) ;;
    *) die "GNU make is required";;
  esac
}

# The root is the in-1 clone itself (the dir this command runs from
# unless IN1_ROOT says otherwise); makes, installs, logs and the
# download cache all live under it.
set-globals() {
  root=$(tilde-expand "${IN1_ROOT:-$self_root}")
  makes=$root/makes
  cache=$(tilde-expand "${IN1_CACHE:-$root/cache}")
}

ensure-makes() {
  mkdir -p "$root/log"
  if [[ ! -d $makes ]]; then
    progress-run makes "$root/log/makes.log" '' '' \
      git clone -q "${IN1_MAKES_REPO:-$MAKES_REPO_DEFAULT}" "$makes" ||
      die "Failed to clone the makes repo"
  fi
}

# Everything an install needs in place: prereqs, globals, the makes
# clone; then either update in-1 and makes (-U) or just say whether
# they are behind.  Runs before tool args are parsed so an update can
# bring in a newly added tool.
prepare-root() {
  check-prereqs
  set-globals
  ensure-makes
  if [[ $update ]]; then
    do-update
  else
    check-stale
  fi
}

# Name of the branch origin/HEAD points at (main when unknown)
default-branch() {  # $1=dir
  local branch
  branch=$(git -C "$1" symbolic-ref -q --short \
    refs/remotes/origin/HEAD 2>/dev/null) || branch=origin/main
  printf '%s' "${branch#origin/}"
}

# Quiet fetch that never prompts and gives up on a stalled connection
git-fetch() {  # $1=dir
  GIT_TERMINAL_PROMPT=0 git -C "$1" \
    -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
    fetch -q --tags origin 2>/dev/null
}

do-update() {
  update-in1
  update-makes
}

update-in1() {
  if [[ ! -e $root/.git ]]; then
    warn "'$root' is not a git clone; not updating in-1"
    return 0
  fi
  git-fetch "$root" || die "Failed to fetch in-1 from origin"
  if [[ ${IN1_VERSION-} ]]; then
    git -C "$root" checkout -q "$IN1_VERSION" ||
      die "Failed to checkout '$IN1_VERSION'"
  else
    local branch
    branch=$(default-branch "$root")
    git -C "$root" checkout -q "$branch" ||
      die "Failed to checkout '$branch'"
    git -C "$root" pull -q || die "Failed to pull latest in-1"
  fi
  warn "in-1 is now at version $(get-version)"
}

update-makes() {
  git -C "$makes" pull -q || die "Failed to pull latest makes"
  warn "makes is now at $(git -C "$makes" rev-parse --short HEAD)"
}

check-stale() {
  [[ ${IN1_OFFLINE-} ]] && return 0
  stale-notice in-1 "$root"
  stale-notice makes "$makes"
}

# One line if the clone in $2 is behind its origin; silent otherwise
# (and when offline)
stale-notice() {  # $1=label $2=dir
  local n
  [[ -e $2/.git ]] || return 0
  git-fetch "$2" || return 0
  n=$(git -C "$2" rev-list --count \
    "HEAD..origin/$(default-branch "$2")" 2>/dev/null) || return 0
  [[ $n -gt 0 ]] || return 0
  warn "$1 is $n commit(s) behind; run 'in-1 -U' to update"
}

# Run a command quietly with a progress line:
#   … LABEL installing....
# erased on completion and replaced by a green check or red X result
# line reporting where it installed and how long it took.  All output
# goes to the log file, shown only on failure.  IN1_VERBOSE=1 streams
# everything instead.
progress-run() {  # $1=label $2=logfile $3=disp $4=note; rest=command
  local label=$1 log=$2 disp=$3 note=$4 rc=0 pid tick=0 start end
  shift 4
  if [[ ${IN1_VERBOSE-} ]]; then
    "$@" 1>&2 || rc=$?
    return $rc
  fi
  start=$(now)
  if [[ -t 2 ]]; then
    printf '… %s installing' "$label" >&2
    "$@" &> "$log" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
      sleep 0.1
      tick=$((tick + 1))
      if [[ $((tick % 10)) -eq 0 ]] && kill -0 "$pid" 2>/dev/null
      then
        printf '.' >&2
      fi
    done
    wait "$pid" || rc=$?
    end=$(now)
    printf '\r\033[K' >&2
  else
    printf '… %s installing\n' "$label" >&2
    "$@" &> "$log" || rc=$?
    end=$(now)
  fi
  progress-line "$rc" "$label" "$disp" "$note" \
    "$(elapsed "$start" "$end")"
  if [[ $rc -ne 0 ]]; then
    tail -20 "$log" >&2
    warn "Full log: $log"
  fi
  return $rc
}

# Print the result line, colored when stderr is a terminal
progress-line() {  # $1=rc $2=label $3=disp $4=note $5=timing
  local rc=$1 label=$2 disp=$3 note=$4 timing=$5
  local to='' also='' g='' r='' z=''
  [[ -n $disp ]] && to=" to $disp"
  [[ -n $note ]] && also=" also: $note"
  if [[ -t 2 ]]; then
    g=$'\033[32m'; r=$'\033[31m'; z=$'\033[0m'
  fi
  if [[ $rc -eq 0 ]]; then
    printf '%s√%s %s installed%s (%ss)%s\n' \
      "$g" "$z" "$label" "$to" "$timing" "$also" >&2
  else
    printf '%sX%s %s NOT installed (%ss)\n' \
      "$r" "$z" "$label" "$timing" >&2
  fi
}

list-tools() {
  set-globals
  ensure-makes
  [[ $update ]] && do-update
  local file name filter
  filter=" $(printf '%s' "$tool_filter" | tr '\n' ' ') "
  for file in "$makes"/*.mk; do
    name=${file##*/}
    name=${name%.mk}
    case $filter in *" $name "*) continue;; esac
    printf '%s\n' "$name"
  done
  list-aliases
}

# Parse args into req_name / req_tool (bare tool or alias names) and
# make_args (any NAME=VALUE argument, passed through to make).  A pin
# is just the tool's make variable, e.g. `perl PERL-VERSION=5.42.0`.
parse-tool-args() {
  req_name=(); req_tool=(); make_args=()
  local arg name tool
  [[ $# -gt 0 ]] || {
    usage >&2
    die "No tools specified"
  }
  for arg; do
    if [[ $arg == *=* ]]; then
      name=${arg%%=*}
      [[ $name =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] ||
        die "Invalid make variable '$name' in '$arg'"
      case $name in
        MAKES-LOCAL-DIR|MAKES_LOCAL_DIR|MAKES_CACHE_DIR)
          die "'$name' is reserved and can not be set";;
      esac
      make_args+=("$arg")
      continue
    fi
    name=$arg
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9.+_-]*$ ]] ||
      die "Invalid tool name '$name'"
    if [[ -f $makes/$name.mk ]]; then
      tool=$name
    else
      tool=$(meta "$name-isa")
      [[ -n $tool ]] ||
        die "Unknown tool '$name'." \
          "Run \`in-1 --list\` to see available tools."
      [[ -f $makes/$tool.mk ]] ||
        die "Alias '$name' maps to unknown tool '$tool'"
    fi
    req_name+=("$name")
    req_tool+=("$tool")
  done
  [[ ${#req_name[@]} -gt 0 ]] || {
    [[ ${#make_args[@]} -gt 0 ]] &&
      die "No tool named. A NAME=VALUE arg sets a make variable;" \
        "add a tool too, e.g. 'perl PERL-VERSION=5.42.0'."
    die "No tools specified"
  }
}

# The primary command shown/versioned for a requested name
primary-of() {  # $1=name
  local p
  p=$(meta "$1-bin")
  [[ -n $p ]] || p=$1
  printf '%s' "$p"
}

gen-makefile() {  # $1=install-dir $2=makefile-path $3=tool
  mkdir -p "${2%/*}"
  {
    # override so a NAME=VALUE make arg can not redirect the install
    printf 'override MAKES-LOCAL-DIR := %s\n' "$1"
    printf 'IN1-SHARE := %s/share\n' "$self_root"
    printf 'include %s/init.mk\n' "$makes"
    printf 'include %s/%s.mk\n' "$makes" "$3"
    # in-1's own per-tool additions (exported vars land in wrappers)
    if [[ -f $self_root/share/$3.mk ]]; then
      # shellcheck disable=SC2016  # make syntax, expanded by make
      printf 'include $(IN1-SHARE)/%s.mk\n' "$3"
    fi
    printf 'include %s/shell.mk\n' "$makes"
    # shellcheck disable=SC2016  # make syntax, expanded by make
    printf 'in1-ver:\n\t@echo $(or $($(PRIMARY)-VERSION),$(%s-VERSION))\n' \
      "$(uc "$3")"
  } > "$2"
}

# Resolve the version to install: the primary command's makes version
# variable (<PRIMARY>-VERSION), falling back to the tool's
# (<TOOL>-VERSION), after any NAME=VALUE make args are applied.  This
# handles tools whose file name differs from their command, like
# fortran.mk providing fpm (FPM-VERSION).
tool-version() {  # $1=tool $2=primary
  local qf=$root/log/$1.ver.mk
  gen-makefile "$root/log/.meta" "$qf" "$1"
  make -s -C "$root" -f "$qf" ${make_args[@]+"${make_args[@]}"} \
    in1-ver PRIMARY="$(uc "$2")" 2>/dev/null || true
}

setup-make-env() {
  # Own the environment make runs in: a parent make (or a makes-based
  # Makefile) may have exported vars that would redirect the install.
  # MAKES_LOCAL_DIR must be unset so each makefile's own
  # MAKES-LOCAL-DIR (one per tool+version) takes effect.
  unset MAKEFLAGS MFLAGS MAKELEVEL GNUMAKEFLAGS MAKEOVERRIDES \
    MAKES_TEE MAKES_SCRIPT MAKES_REPO_DIR MAKES_LOCAL_DIR \
    2>/dev/null || true
  export MAKES_CACHE_DIR=$cache
  mkdir -p "$cache"
}

capture-env() {  # $1=makefile-path $2=out-file
  # deps are up to date now; dump the recipe environment
  env_sep='nl'
  if env -0 >/dev/null 2>&1; then
    env_sep=nul
    make -s -C "$root" -f "$1" ${make_args[@]+"${make_args[@]}"} \
      shell CMD='exec env -0' > "$2" ||
      die "Environment capture failed"
  else
    make -s -C "$root" -f "$1" ${make_args[@]+"${make_args[@]}"} \
      shell CMD='exec env' > "$2" ||
      die "Environment capture failed"
  fi
}

load-env() {  # $1=env-file; fills env_names/env_values
  env_names=() env_values=()
  local entry
  if [[ $env_sep == nul ]]; then
    while IFS= read -r -d '' entry; do
      add-env-entry "$entry"
    done < "$1"
  else
    while IFS= read -r entry; do
      add-env-entry "$entry"
    done < "$1"
  fi
}

add-env-entry() {
  local name=${1%%=*}
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 0
  env_names+=("$name")
  env_values+=("${1#*=}")
}

# Remove every occurrence of entry $2 from colon list $1
strip-entry() {
  local rest=$1 out='' dir
  while [[ -n $rest ]]; do
    dir=${rest%%:*}
    if [[ $rest == *:* ]]; then rest=${rest#*:}; else rest=''; fi
    [[ $dir == "$2" ]] && continue
    out=$out$dir:
  done
  printf '%s' "${out%:}"
}

# Prepend entries of colon list $1 not already in colon list $2
path-merge() {
  local out=$2 i dir
  local -a parts=()
  IFS=: read -ra parts <<< "$1"
  for ((i=${#parts[@]}-1; i>=0; i--)); do
    dir=${parts[i]}
    [[ -n $dir ]] || continue
    case ":$out:" in *":$dir:"*) continue;; esac
    out=$dir:$out
  done
  printf '%s' "$out"
}

# Diff env_names/env_values (a tool's install env) against our own.
# Fills out_names/out_values (tool vars) and added_dirs (the tool's
# new PATH dirs).  $makes/util is stripped.
compute-exports() {
  out_names=() out_values=() added_dirs=()
  local i name value cur denied new_path=''
  denied=" $(printf '%s' "$env_denylist" | tr '\n' ' ') "
  for ((i=0; i<${#env_names[@]}; i++)); do
    name=${env_names[i]}
    value=${env_values[i]}
    case $denied in *" $name "*) continue;; esac
    if [[ $name == PATH ]]; then
      new_path=$value
      continue
    fi
    if [[ ${!name+x} ]]; then cur=${!name}; else cur=$'\1unset\1'; fi
    [[ $value == "$cur" ]] && continue
    if [[ -n $cur && $cur != $'\1unset\1' && $value == *":$cur" ]]
    then
      value=$(path-merge "${value%":$cur"}" "$cur")
      [[ $value == "$cur" ]] && continue
    fi
    out_names+=("$name")
    out_values+=("$value")
  done

  [[ -n $new_path ]] || return 0
  new_path=$(strip-entry "$new_path" "$makes/util")
  local rest dir
  rest=$new_path
  while [[ -n $rest ]]; do
    dir=${rest%%:*}
    if [[ $rest == *:* ]]; then rest=${rest#*:}; else rest=''; fi
    [[ -n $dir ]] || continue
    case ":$PATH:" in *":$dir:"*) continue;; esac
    case " ${added_dirs[*]-} " in *" $dir "*) continue;; esac
    added_dirs+=("$dir")
  done
}

# Append this tool's man dirs (siblings of its bin dirs) to man_adds
collect-manpath() {
  local dir man
  for dir in ${added_dirs[@]+"${added_dirs[@]}"}; do
    for man in "${dir%/*}/share/man" "${dir%/*}/man"; do
      [[ -d $man ]] || continue
      case ":$man_adds:" in *":$man:"*) continue;; esac
      man_adds=$man_adds${man_adds:+:}$man
    done
  done
}

# Single-quote $1 for bash/zsh eval
sq() {
  local s=${1//\'/\'\\\'\'}
  printf "'%s'" "$s"
}

# Single-quote $1 for fish eval
fq() {
  local s=${1//\\/\\\\}
  s=${s//\'/\\\'}
  printf "'%s'" "$s"
}

# Write one env-baking wrapper (live PATH prepend).  Uses the current
# out_names/out_values for the tool's env vars.  $4, if given, is a
# bash snippet run before the exec; $cmd holds the real command.
write-one-wrapper() {  # $1=real-cmd $2=wrapper-path $3=path-prefix
  local i
  if [[ -e $2 ]] &&
     ! grep -q '^# in-1 wrapper$' "$2" 2>/dev/null; then
    warn "Skipping existing non-wrapper file '$2'"
    return 0
  fi
  {
    printf '#!/usr/bin/env bash\n'
    printf '# in-1 wrapper\n'
    for ((i=0; i<${#out_names[@]}; i++)); do
      case ${out_names[i]} in PATH|MANPATH) continue;; esac
      printf 'export %s=%q\n' "${out_names[i]}" "${out_values[i]}"
    done
    # shellcheck disable=SC2016  # $PATH expands when the wrapper runs
    printf 'export PATH=%q${PATH:+:$PATH}\n' "$3"
    printf 'cmd=%q\n' "$1"
    [[ -n ${4-} ]] && cat "$4"
    # shellcheck disable=SC2016  # $cmd expands when the wrapper runs
    printf 'exec "$cmd" "$@"\n'
  } > "$2"
  chmod +x "$2"
  wrap_count=$((wrap_count + 1))
}

# Write wrappers into $install_root/bin for every command a tool
# installed; the primary command also gets a <primary>-<version> one.
# The primary's wrappers include share/<tool>.wrap when it exists.
write-wrappers() {  # $1=version $2=primary $3=tool
  local pfx dir f cmd primary_real='' snip=''
  pfx=$(join-colon ${added_dirs[@]+"${added_dirs[@]}"})
  [[ -f $self_root/share/$3.wrap ]] && snip=$self_root/share/$3.wrap
  for dir in ${added_dirs[@]+"${added_dirs[@]}"}; do
    for f in "$dir"/*; do
      [[ -f $f && -x $f ]] || continue
      cmd=${f##*/}
      [[ $cmd == .* ]] && continue
      if [[ $cmd == "$2" ]]; then
        primary_real=$f
        write-one-wrapper "$f" "$install_root/bin/$cmd" "$pfx" "$snip"
      else
        write-one-wrapper "$f" "$install_root/bin/$cmd" "$pfx"
      fi
    done
  done
  if [[ -n $primary_real ]]; then
    write-one-wrapper "$primary_real" \
      "$install_root/bin/$2-$1" "$pfx" "$snip"
  fi
}

# Install every requested tool into its own share/<tool>/<version>
# tree and write command wrappers into $install_root/bin.
install-all() {  # $1=install-root
  install_root=$1
  setup-make-env
  mkdir -p "$root/log" "$install_root/bin"
  man_adds=''
  comp_dirs=()
  wrap_count=0
  local i name tool version idir mf primary disp note
  local envfile=$root/log/in-1-env.$$
  for ((i=0; i<${#req_name[@]}; i++)); do
    name=${req_name[i]}
    tool=${req_tool[i]}
    primary=$(primary-of "$name")
    version=$(tool-version "$tool" "$primary")
    [[ -n $version ]] || version=current
    idir=$install_root/share/$tool/$version
    mf=$root/log/$tool.mk
    gen-makefile "$idir" "$mf" "$tool"
    disp=$install_root/bin/$primary
    note=$(meta "$name-also")
    progress-run "$primary v$version" "$root/log/$tool.log" \
      "$disp" "$note" \
      make --no-print-directory -C "$root" -f "$mf" \
      ${make_args[@]+"${make_args[@]}"} shell CMD=: ||
      exit 1
    capture-env "$mf" "$envfile"
    load-env "$envfile"
    rm -f "$envfile"
    compute-exports
    write-wrappers "$version" "$primary" "$tool"
    collect-manpath
    comp_dirs+=("$idir")
  done
}

# --- shell emit (session mode) ---------------------------------------

emit-prepend-sh() {  # $1=var $2=dir
  # shellcheck disable=SC2016  # $var expands in the emitted user shell
  printf 'case ":${%s-}:" in *":%s:"*) ;; *) export %s=%s${%s:+:$%s};; esac\n' \
    "$1" "$2" "$1" "$(sq "$2")" "$1" "$1"
}

emit-manpath-sh() {
  [[ -n $man_adds ]] || return 0
  local first=${man_adds%%:*}
  # shellcheck disable=SC2016  # $MANPATH expands in the emitted shell
  printf 'case ":${MANPATH-}:" in *":%s:"*) ;; *) if [ -n "${MANPATH-}" ]; then export MANPATH=%s:$MANPATH; else export MANPATH=%s:; fi;; esac\n' \
    "$first" "$(sq "$man_adds")" "$(sq "$man_adds")"
}

emit-session-sh() {  # $1=bash|zsh
  emit-prepend-sh PATH "$install_root/bin"
  emit-manpath-sh
  emit-completions "$1"
  emit-extras "$1"
  emit-tools-var sh
  printf 'hash -r 2>/dev/null || true\n'
}

emit-session-fish() {
  local bindir=$install_root/bin dir
  # shellcheck disable=SC2016  # $PATH expands in the user's fish
  printf 'contains -- %s $PATH; or set -gx PATH %s $PATH\n' \
    "$(fq "$bindir")" "$(fq "$bindir")"
  if [[ -n $man_adds ]]; then
    printf 'set -q MANPATH; or set -gx MANPATH ""\n'
    local rest=$man_adds
    while [[ -n $rest ]]; do
      dir=${rest%%:*}
      if [[ $rest == *:* ]]; then rest=${rest#*:}; else rest=''; fi
      # shellcheck disable=SC2016  # $MANPATH expands in the user's fish
      printf 'contains -- %s $MANPATH; or set -gx MANPATH %s $MANPATH\n' \
        "$(fq "$dir")" "$(fq "$dir")"
    done
  fi
  emit-completions fish
  emit-extras fish
  emit-tools-var fish
}

emit-tools-var() {  # $1=sh|fish
  local list=${IN1_TOOLS-} n
  for n in ${req_name[@]+"${req_name[@]}"}; do
    case " $list " in *" $n "*) continue;; esac
    list=$list${list:+ }$n
  done
  if [[ $1 == fish ]]; then
    printf 'set -gx IN1_TOOLS %s\n' "$(fq "$list")"
  else
    printf 'export IN1_TOOLS=%s\n' "$(sq "$list")"
  fi
}

# Source share/<name>.<ext> extras for the target shell, if present
emit-extras() {  # $1=bash|zsh|fish
  local exts n ext file
  case $1 in
    bash) exts='sh bash';;
    zsh) exts='sh zsh';;
    fish) exts='fish';;
  esac
  for n in ${req_name[@]+"${req_name[@]}"}; do
    for ext in $exts; do
      file=$self_root/share/$n.$ext
      [[ -f $file ]] || continue
      if [[ $1 == fish ]]; then
        printf 'set -gx IN1_ROOT %s\n' "$(fq "$root")"
        printf 'source %s\n' "$(fq "$file")"
      else
        printf 'export IN1_ROOT=%s\n' "$(sq "$root")"
        printf 'source %s\n' "$(sq "$file")"
      fi
    done
  done
}

# Best-effort completion setup from each installed tool tree
emit-completions() {  # $1=bash|zsh|fish
  local d dir file
  for d in ${comp_dirs[@]+"${comp_dirs[@]}"}; do
    case $1 in
      bash)
        for dir in "$d/share/bash-completion/completions" \
                   "$d/etc/bash_completion.d"; do
          [[ -d $dir ]] || continue
          for file in "$dir"/*; do
            [[ -f $file ]] || continue
            printf 'source %s 2>/dev/null || true\n' "$(sq "$file")"
          done
        done
        ;;
      zsh)
        dir=$d/share/zsh/site-functions
        # shellcheck disable=SC2016  # $fpath expands in the user's zsh
        [[ -d $dir ]] &&
          printf 'fpath=(%s $fpath)\n' "$(sq "$dir")"
        ;;
      fish)
        dir=$d/share/fish/vendor_completions.d
        # shellcheck disable=SC2016  # expands in the user's fish
        [[ -d $dir ]] &&
          printf 'set -g fish_complete_path %s $fish_complete_path\n' \
            "$(fq "$dir")"
        ;;
    esac
  done
  return 0
}

# --- modes -----------------------------------------------------------

session-prepare() {  # sets install_root, installs, writes wrappers
  prepare-root
  parse-tool-args "$@"
  install-all "$(abs-path "${PREFIX:-$root/local}")"
}

do-env() {
  local shell=$1; shift
  case $shell in
    bash|zsh|fish) ;;
    sh) shell=bash;;
    *) die "Unsupported shell '$shell' (want bash, zsh or fish)";;
  esac
  session-prepare "$@"
  if [[ $shell == fish ]]; then
    emit-session-fish
  else
    emit-session-sh "$shell"
  fi
}

do-run() {
  session-prepare "$@"
  warn "Tools installed; wrappers are in '$install_root/bin'." \
    "" \
    "A command can not change its parent shell's environment." \
    "To put them on PATH in your current shell run one of:" \
    "" \
    "  eval \"\$(in-1 --env bash ${req_name[*]})\"  # bash" \
    "  eval \"\$(in-1 --env zsh ${req_name[*]})\"   # zsh" \
    "  in-1 --env fish ${req_name[*]} | source    # fish" \
    "" \
    "Or 'source /path/to/in-1/.rc' first to get an 'in-1' command" \
    "that does this for you."
}

do-local() {
  local prefix=${PREFIX:-}
  if [[ -z $prefix ]]; then
    if [[ ${EUID:-$(id -u)} == 0 ]]; then
      prefix=/usr/local
    else
      prefix=$HOME/.local
    fi
  fi
  prefix=$(abs-path "$prefix")
  if [[ $prefix == */bin ]]; then
    prefix=${prefix%/bin}
    warn "Stripped trailing /bin from PREFIX; using PREFIX=$prefix"
  fi

  prepare-root
  parse-tool-args "$@"
  install-all "$prefix"

  warn "Installed ${req_name[*]}:" \
    "$wrap_count command wrappers in '$prefix/bin'"
  case ":$PATH:" in
    *":$prefix/bin:"*) ;;
    *) warn "Note: '$prefix/bin' is not in your PATH";;
  esac
}

do-complete() {
  case $1 in
    bash)
      cat <<'...'
_in_1_complete() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local opts='--env --local --list --complete -U --update --version --help'
  local tools
  tools=$(command in-1 --list 2>/dev/null || true)
  COMPREPLY=()
  while IFS= read -r word; do
    COMPREPLY+=("$word")
  done < <(compgen -W "$opts $tools" -- "$cur")
}
complete -F _in_1_complete in-1
...
      ;;
    zsh)
      cat <<'...'
_in_1_complete() {
  local -a opts tools
  opts=(--env --local --list --complete -U --update --version --help)
  tools=(${(f)"$(command in-1 --list 2>/dev/null)"})
  _describe 'in-1' opts -- tools
}
if (( $+functions[compdef] )); then
  compdef _in_1_complete in-1
fi
...
      ;;
    fish)
      cat <<'...'
complete -c in-1 -f
complete -c in-1 -a '(command in-1 --list 2>/dev/null)'
complete -c in-1 -l env -d 'Print env setup code for a shell'
complete -c in-1 -l local -d 'Install tools under PREFIX'
complete -c in-1 -l list -d 'List available tools'
complete -c in-1 -l complete -d 'Print command completion for a shell'
complete -c in-1 -s U -l update -d 'Update in-1 and makes first'
complete -c in-1 -l version -d 'Print the in-1 version'
complete -c in-1 -l help -d 'Show help'
...
      ;;
    *) die "Unsupported shell '$1' (want bash, zsh or fish)";;
  esac
}

main "$@"
